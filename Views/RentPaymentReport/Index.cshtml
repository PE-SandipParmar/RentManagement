@model RentPaymentReportModel
@{
    ViewData["Title"] = "Rent Payment Report";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .gradient-bg {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    }
    .glass-effect {
        background: rgba(255, 255, 255, 0.25);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255, 255, 255, 0.18);
    }
    .status-badge {
        padding: 4px 12px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 500;
    }
    .status-active { background-color: #dcfce7; color: #166534; }
    .status-pending { background-color: #fef3c7; color: #d97706; }
    .status-inactive { background-color: #fee2e2; color: #dc2626; }
    .chart-container {
        min-height: 300px;
        background: white;
        border-radius: 12px;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
    }
    .pagination-container {
        display: flex;
        justify-content: center;
        align-items: center;
        margin-top: 2rem;
        gap: 0.5rem;
    }
    .pagination-info {
        color: #6b7280;
        font-size: 0.875rem;
    }
    .remarks-text {
        cursor: pointer;
        position: relative;
        display: inline-block;
    }
    .remarks-text:hover {
        color: #3b82f6;
        text-decoration: underline;
    }
    .remarks-tooltip {
        position: absolute;
        background: #1f2937;
        color: white;
        padding: 8px 12px;
        border-radius: 6px;
        font-size: 12px;
        white-space: nowrap;
        z-index: 1000;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
        max-width: 300px;
        white-space: normal;
        word-wrap: break-word;
        display: none;
    }
    .remarks-tooltip::after {
        content: '';
        position: absolute;
        top: 100%;
        left: 50%;
        margin-left: -5px;
        border-width: 5px;
        border-style: solid;
        border-color: #1f2937 transparent transparent transparent;
    }
    .report-header {
        background: linear-gradient(135deg, #1e40af 0%, #3b82f6 100%);
        color: white;
        padding: 2rem;
        border-radius: 12px;
        margin-bottom: 2rem;
    }
    .organization-info {
        text-align: center;
        margin-bottom: 1rem;
    }
    .organization-name {
        font-size: 1.5rem;
        font-weight: bold;
        margin-bottom: 0.5rem;
    }
    .organization-address {
        font-size: 0.9rem;
        opacity: 0.9;
    }
    .voucher-info {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-top: 1rem;
        padding-top: 1rem;
        border-top: 1px solid rgba(255, 255, 255, 0.2);
    }
    .voucher-details {
        display: flex;
        gap: 2rem;
    }
    .voucher-item {
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
    }
    .voucher-label {
        font-size: 0.8rem;
        opacity: 0.8;
    }
    .voucher-value {
        font-weight: 600;
    }
</style>

<!-- Report Header -->
<div class="report-header">
    <div class="organization-info">
        <div class="organization-name">@Model.OrganizationName</div>
        <div class="organization-address">@Model.OrganizationAddress</div>
    </div>
    <div class="voucher-info">
        <div class="voucher-details">
            <div class="voucher-item">
                <span class="voucher-label">Voucher No.</span>
                <span class="voucher-value">@Model.VoucherNumber</span>
            </div>
            <div class="voucher-item">
                <span class="voucher-label">Cheque No.</span>
                <span class="voucher-value">@Model.ChequeNumber</span>
            </div>
            <div class="voucher-item">
                <span class="voucher-label">Payment Date</span>
                <span class="voucher-value">@Model.PaymentDate.ToString("dd/MM/yyyy")</span>
            </div>
        </div>
        <div class="glass-effect rounded-lg px-4 py-2">
            <span class="text-sm">Generated: <span id="lastUpdated">@DateTime.Now.ToString("dd MMM yyyy HH:mm")</span></span>
        </div>
    </div>
</div>

<div class="container mx-auto px-6 py-8">
    <!-- No Data Alert -->
    @if (Model.TotalRecords == 0 && ViewBag.DiagnosticInfo != null)
    {
        <div class="bg-orange-50 border border-orange-200 rounded-lg p-4 mb-6">
            <div class="flex items-center">
                <i class="ri-information-line text-orange-600 text-xl mr-3"></i>
                <div>
                    <h4 class="text-orange-800 font-medium">No Rent Payment Data Available</h4>
                    <p class="text-orange-700 text-sm mt-1">
                        @if (!ViewBag.DiagnosticInfo.HasData)
                        {
                            <span>No Rent Payments found in the database. Please create some payments first.</span>
                        }
                        else if (!ViewBag.DiagnosticInfo.HasRentData)
                        {
                            <span>Rent Payments exist but none match your current filter criteria. Try adjusting the filters below.</span>
                        }
                        else
                        {
                            <span>No data matches your current filter criteria. Try adjusting the filters below.</span>
                        }
                    </p>
                </div>
            </div>
        </div>
    }

    <!-- Quick Stats Dashboard -->
    <div class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-8">
        <div class="bg-white rounded-xl p-6 shadow-sm border border-gray-100">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm font-medium text-gray-600">Total Payments</p>
                    <p class="text-2xl font-bold text-gray-900" id="totalPayments">@Model.Summary.TotalPayments</p>
                </div>
                <div class="w-12 h-12 bg-blue-100 rounded-lg flex items-center justify-center">
                    <i class="ri-calendar-check-line text-blue-600 text-xl"></i>
                </div>
            </div>
        </div>
        <div class="bg-white rounded-xl p-6 shadow-sm border border-gray-100">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm font-medium text-gray-600">Total Amount</p>
                    <p class="text-2xl font-bold text-gray-900" id="totalAmount">₹@Model.Summary.TotalAmount.ToString("N2")</p>
                </div>
                <div class="w-12 h-12 bg-green-100 rounded-lg flex items-center justify-center">
                    <i class="ri-money-dollar-circle-line text-green-600 text-xl"></i>
                </div>
            </div>
        </div>
        <div class="bg-white rounded-xl p-6 shadow-sm border border-gray-100">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm font-medium text-gray-600">Total Payable</p>
                    <p class="text-2xl font-bold text-gray-900" id="totalPayable">₹@Model.Summary.TotalPayable.ToString("N2")</p>
                </div>
                <div class="w-12 h-12 bg-purple-100 rounded-lg flex items-center justify-center">
                    <i class="ri-bank-card-line text-purple-600 text-xl"></i>
                </div>
            </div>
        </div>
        <div class="bg-white rounded-xl p-6 shadow-sm border border-gray-100">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm font-medium text-gray-600">Unique Vendors</p>
                    <p class="text-2xl font-bold text-gray-900" id="uniqueVendors">@Model.Summary.UniqueVendors</p>
                </div>
                <div class="w-12 h-12 bg-orange-100 rounded-lg flex items-center justify-center">
                    <i class="ri-team-line text-orange-600 text-xl"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Filter Configuration -->
    <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-6 mb-8">
        <h3 class="text-lg font-semibold mb-6 flex items-center">
            <i class="ri-settings-line mr-2 text-primary"></i>
            Filter Configuration
        </h3>
        
        <form id="rentPaymentReportForm" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-2">Date Range</label>
                <div class="grid grid-cols-2 gap-2">
                    <input type="date" id="FromDate" name="FromDate" value="@Model.Filter.FromDate?.ToString("yyyy-MM-dd")" class="border border-gray-300 rounded-lg px-3 py-2 focus:ring-2 focus:ring-primary focus:border-primary">
                    <input type="date" id="ToDate" name="ToDate" value="@Model.Filter.ToDate?.ToString("yyyy-MM-dd")" class="border border-gray-300 rounded-lg px-3 py-2 focus:ring-2 focus:ring-primary focus:border-primary">
                </div>
            </div>

            <div>
                <label class="block text-sm font-medium text-gray-700 mb-2">Employee Code</label>
                <input type="text" id="EmployeeCode" name="EmployeeCode" value="@Model.Filter.EmployeeCode" placeholder="Enter employee code" class="w-full border border-gray-300 rounded-lg px-3 py-2 focus:ring-2 focus:ring-primary focus:border-primary">
            </div>

            <div>
                <label class="block text-sm font-medium text-gray-700 mb-2">Employee Name</label>
                <input type="text" id="EmployeeName" name="EmployeeName" value="@Model.Filter.EmployeeName" placeholder="Enter employee name" class="w-full border border-gray-300 rounded-lg px-3 py-2 focus:ring-2 focus:ring-primary focus:border-primary">
            </div>

            <div>
                <label class="block text-sm font-medium text-gray-700 mb-2">Vendor Code</label>
                <input type="text" id="VendorCode" name="VendorCode" value="@Model.Filter.VendorCode" placeholder="Enter vendor code" class="w-full border border-gray-300 rounded-lg px-3 py-2 focus:ring-2 focus:ring-primary focus:border-primary">
            </div>

            <div>
                <label class="block text-sm font-medium text-gray-700 mb-2">Vendor Name</label>
                <input type="text" id="VendorName" name="VendorName" value="@Model.Filter.VendorName" placeholder="Enter vendor name" class="w-full border border-gray-300 rounded-lg px-3 py-2 focus:ring-2 focus:ring-primary focus:border-primary">
            </div>

            <div>
                <label class="block text-sm font-medium text-gray-700 mb-2">PAN Number</label>
                <input type="text" id="PAN" name="PAN" value="@Model.Filter.PAN" placeholder="Enter PAN number" class="w-full border border-gray-300 rounded-lg px-3 py-2 focus:ring-2 focus:ring-primary focus:border-primary">
            </div>

            <div>
                <label class="block text-sm font-medium text-gray-700 mb-2">Voucher Number</label>
                <input type="text" id="VoucherNumber" name="VoucherNumber" value="@Model.Filter.VoucherNumber" placeholder="Enter voucher number" class="w-full border border-gray-300 rounded-lg px-3 py-2 focus:ring-2 focus:ring-primary focus:border-primary">
            </div>

            <div>
                <label class="block text-sm font-medium text-gray-700 mb-2">Cheque Number</label>
                <input type="text" id="ChequeNumber" name="ChequeNumber" value="@Model.Filter.ChequeNumber" placeholder="Enter cheque number" class="w-full border border-gray-300 rounded-lg px-3 py-2 focus:ring-2 focus:ring-primary focus:border-primary">
            </div>

            <div>
                <label class="block text-sm font-medium text-gray-700 mb-2">Financial Year</label>
                <select id="FinancialYear" name="FinancialYear" class="w-full border border-gray-300 rounded-lg px-3 py-2 focus:ring-2 focus:ring-primary focus:border-primary">
                    @if (ViewBag.FinancialYearOptions != null)
                    {
                        @foreach (var year in ViewBag.FinancialYearOptions)
                        {
                            var isSelected = Model.Filter.FinancialYear == year.Value ? "selected" : "";
                            <option value="@year.Value" selected=@isSelected>@year.Text</option>
                        }
                    }
                </select>
            </div>

            <div>
                <label class="block text-sm font-medium text-gray-700 mb-2">Month</label>
                <select id="Month" name="Month" class="w-full border border-gray-300 rounded-lg px-3 py-2 focus:ring-2 focus:ring-primary focus:border-primary">
                    @if (ViewBag.MonthOptions != null)
                    {
                        @foreach (var month in ViewBag.MonthOptions)
                        {
                            var isSelected = Model.Filter.Month == month.Value ? "selected" : "";
                            if (Model.Filter.Month == month.Value)
                            {
                                <option value="@month.Value" selected="selected">@month.Text</option>
                            }
                            else
                            {
                                <option value="@month.Value">@month.Text</option>
                            }
                        }
                    }
                </select>
            </div>

            <div>
                <label class="block text-sm font-medium text-gray-700 mb-2">Payment Status</label>
                <select id="PaymentStatus" name="PaymentStatus" class="w-full border border-gray-300 rounded-lg px-3 py-2 focus:ring-2 focus:ring-primary focus:border-primary">
                    <option value="" selected>All Status</option>
                    @if (ViewBag.PaymentStatusOptions != null)
                    {
                        @foreach (var status in ViewBag.PaymentStatusOptions)
                        {
                            var isSelected = Model.Filter.PaymentStatus == status.Value ? "selected" : "";
                            <option value="@status.Value">@status.Text</option>
                        }
                    }
                </select>
            </div>

            <div>
                <label class="block text-sm font-medium text-gray-700 mb-2">Bank Name</label>
                <input type="text" id="BankName" name="BankName" value="@Model.Filter.BankName" placeholder="Enter bank name" class="w-full border border-gray-300 rounded-lg px-3 py-2 focus:ring-2 focus:ring-primary focus:border-primary">
            </div>

            <div>
                <label class="block text-sm font-medium text-gray-700 mb-2">Sort By</label>
                <select id="SortBy" name="SortBy" class="w-full border border-gray-300 rounded-lg px-3 py-2 focus:ring-2 focus:ring-primary focus:border-primary">
                    @if (ViewBag.SortOptions != null)
                    {
                        @foreach (var sort in ViewBag.SortOptions)
                        {
                            var isSelected = Model.Filter.SortBy == sort.Value ? "selected" : "";
                            <option value="@sort.Value" selected=@isSelected>@sort.Text</option>
                        }
                    }
                </select>
            </div>

            <div>
                <label class="block text-sm font-medium text-gray-700 mb-2">Sort Order</label>
                <select id="SortOrder" name="SortOrder" class="w-full border border-gray-300 rounded-lg px-3 py-2 focus:ring-2 focus:ring-primary focus:border-primary">
                    <option value="DESC" selected="@(Model.Filter.SortOrder == "DESC")">Descending</option>
                    <option value="ASC" selected="@(Model.Filter.SortOrder == "ASC")">Ascending</option>
                </select>
            </div>

            <div class="flex items-center space-x-2">
                <input type="checkbox" id="IncludeZeroAmounts" name="IncludeZeroAmounts" value="true" @(Model.Filter.IncludeZeroAmounts ? "checked" : "") class="rounded border-gray-300 text-primary focus:ring-primary">
                <label for="IncludeZeroAmounts" class="text-sm text-gray-700">Include Zero Amount Payments</label>
            </div>

            <div class="md:col-span-2 lg:col-span-4 pt-4">
                <button type="submit" class="bg-primary text-white px-6 py-2 rounded-lg hover:bg-primary/90 transition-colors">
                    <i class="ri-search-line mr-2"></i>Generate Report
                </button>
            </div>
        </form>
    </div>

    <!-- Report Data -->
    <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-6">
        <div class="flex items-center justify-between mb-6">
            <h3 class="text-lg font-semibold flex items-center">
                <i class="ri-file-list-line mr-2 text-primary"></i>
                Rent Payment Report Data
            </h3>
            <div class="flex items-center space-x-2">
                <button onclick="exportReport('PDF')" class="bg-red-600 text-white px-3 py-2 rounded-lg text-sm hover:bg-red-700 transition-colors">
                    <i class="ri-file-pdf-line mr-1"></i>PDF
                </button>
                <button onclick="exportReport('EXCEL')" class="bg-green-600 text-white px-3 py-2 rounded-lg text-sm hover:bg-green-700 transition-colors">
                    <i class="ri-file-excel-line mr-1"></i>Excel
                </button>
                <button onclick="exportReport('CSV')" class="bg-blue-600 text-white px-3 py-2 rounded-lg text-sm hover:bg-blue-700 transition-colors">
                    <i class="ri-file-text-line mr-1"></i>CSV
                </button>
            </div>
        </div>

        <!-- Report Table -->
        <div class="overflow-x-auto">
            <table class="w-full text-sm text-left text-gray-500">
                <thead class="text-xs text-gray-700 uppercase bg-gray-50">
                    <tr>
                        <th class="px-6 py-3">Sl No</th>
                        <th class="px-6 py-3">Payment No.</th>
                        <th class="px-6 py-3">Transaction No.</th>
                        <th class="px-6 py-3">Vendor Name</th>
                        <th class="px-6 py-3">Bank Name</th>
                        <th class="px-6 py-3">Account No.</th>
                        <th class="px-6 py-3">PAN</th>
                        <th class="px-6 py-3">Invoice No. & dt</th>
                        <th class="px-6 py-3">IFSC</th>
                        <th class="px-6 py-3">Amount</th>
                        <th class="px-6 py-3">Adjustment</th>
                        <th class="px-6 py-3">Recoveries</th>
                        <th class="px-6 py-3">Payable</th>
                        <th class="px-6 py-3">Employee Name</th>
                        <th class="px-6 py-3">Remarks</th>
                    </tr>
                </thead>
                <tbody id="reportTableBody">
                    @if (Model.PaymentItems != null && Model.PaymentItems.Any())
                    {
                        @foreach (var item in Model.PaymentItems)
                        {
                            <tr class="bg-white border-b hover:bg-gray-50">
                                <td class="px-6 py-4">@item.SlNo</td>
                                <td class="px-6 py-4 font-medium">@item.PaymentNumber</td>
                                <td class="px-6 py-4 font-medium">@item.TransactionNumber</td>
                                <td class="px-6 py-4">@item.VendorName</td>
                                <td class="px-6 py-4">@item.BankName</td>
                                <td class="px-6 py-4 font-mono">@item.AccountNumber</td>
                                <td class="px-6 py-4 font-mono">@item.PAN</td>
                                <td class="px-6 py-4">@item.InvoiceNumber dt : @item.InvoiceDate.ToString("dd/MM/yyyy")</td>
                                <td class="px-6 py-4 font-mono">@item.IFSC</td>
                                <td class="px-6 py-4 font-medium text-green-600">₹@item.Amount.ToString("N2")</td>
                                <td class="px-6 py-4 font-medium text-blue-600">₹@item.Adjustment.ToString("N2")</td>
                                <td class="px-6 py-4 font-medium text-purple-600">₹@item.Recoveries.ToString("N2")</td>
                                <td class="px-6 py-4 font-medium text-orange-600">₹@item.Payable.ToString("N2")</td>
                                <td class="px-6 py-4">@item.EmployeeName</td>
                                <td class="px-6 py-4">
                                    <span class="remarks-text" title="@item.Remarks">
                                        @(item.Remarks?.Length > 30 ? item.Remarks.Substring(0, 30) + "..." : item.Remarks)
                                    </span>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="15" class="px-6 py-12 text-center">
                                <div class="text-gray-500">
                                    <i class="ri-inbox-line text-4xl mb-4"></i>
                                    <h5 class="text-lg font-medium">No Rent Payment data found</h5>
                                    <p class="text-sm">Try adjusting your filter options to see more results.</p>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Pagination -->
        <div id="paginationContainer" class="mt-6 @(Model.TotalRecords <= 20 ? "hidden" : "")">
            <div class="flex items-center justify-between">
                <div class="text-sm text-gray-700">
                    Showing <span id="recordCount">@Model.TotalRecords</span> records
                </div>
                <div class="flex items-center space-x-2" id="pagination">
                    <!-- Pagination will be populated by JavaScript -->
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Loading Overlay -->
<div id="loadingOverlay" class="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50 hidden">
    <div class="bg-white rounded-lg p-6 flex items-center space-x-3">
        <div class="animate-spin rounded-full h-6 w-6 border-b-2 border-primary"></div>
        <span>Generating report...</span>
    </div>
</div>

<!-- Toast Notification -->
<div id="toast" class="fixed bottom-6 right-6 px-6 py-3 rounded-lg shadow-lg z-50 transform transition-transform translate-y-full hidden">
    <span id="toastMessage"></span>
</div>

@section Scripts {
    <script>
        function showLoading() {
            document.getElementById('loadingOverlay').classList.remove('hidden');
        }

        function hideLoading() {
            document.getElementById('loadingOverlay').classList.add('hidden');
        }

        function updatePagination(totalRecords) {
            const pagination = document.getElementById('pagination');
            const pageSize = 20;
            const totalPages = Math.ceil(totalRecords / pageSize);
            
            if (totalPages <= 1) {
                pagination.innerHTML = '';
                return;
            }

            let paginationHtml = '';
            
            // Previous button
            paginationHtml += `
                <button onclick="changePage(${Math.max(1, 1 - 1)})" class="px-3 py-2 text-sm border border-gray-300 rounded-lg hover:bg-gray-50">
                    <i class="ri-arrow-left-s-line"></i>
                </button>
            `;

            // Page numbers
            for (let i = 1; i <= totalPages; i++) {
                if (i === 1 || i === totalPages || (i >= 1 - 2 && i <= 1 + 2)) {
                    paginationHtml += `
                        <button onclick="changePage(${i})" class="px-3 py-2 text-sm border border-gray-300 rounded-lg hover:bg-gray-50 ${i === 1 ? 'bg-primary text-white' : ''}">
                            ${i}
                        </button>
                    `;
                } else if (i === 1 - 3 || i === 1 + 3) {
                    paginationHtml += '<span class="px-2 py-2 text-gray-500">...</span>';
                }
            }

            // Next button
            paginationHtml += `
                <button onclick="changePage(${Math.min(totalPages, 1 + 1)})" class="px-3 py-2 text-sm border border-gray-300 rounded-lg hover:bg-gray-50">
                    <i class="ri-arrow-right-s-line"></i>
                </button>
            `;

            pagination.innerHTML = paginationHtml;
        }

        function changePage(page) {
            const form = document.getElementById('rentPaymentReportForm');
            const pageInput = document.createElement('input');
            pageInput.type = 'hidden';
            pageInput.name = 'Page';
            pageInput.value = page;
            form.appendChild(pageInput);
            form.submit();
        }

        // Form submission
        document.getElementById('rentPaymentReportForm').addEventListener('submit', function(e) {
            e.preventDefault();
            showLoading();
            
            const formData = new FormData(this);
            formData.append('Page', '1'); // Reset to first page on new search
            
            fetch('@Url.Action("Details", "RentPaymentReport")', {
                method: 'POST',
                body: formData,
                headers: {
                    'X-Requested-With': 'XMLHttpRequest'
                }
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    updateReportTable(data.data);
                    updateSummary(data.data.summary);
                    updatePagination(data.data.totalRecords);
                } else {
                    showToast(data.message || 'Error loading report data', 'error');
                }
            })
            .catch(error => {
                console.error('Error:', error);
                showToast('Error loading report data', 'error');
            })
            .finally(() => {
                hideLoading();
            });
        });

        function updateReportTable(data) {
            const tbody = document.getElementById('reportTableBody');
            tbody.innerHTML = '';

            if (data.paymentItems && data.paymentItems.length > 0) {
                data.paymentItems.forEach((item, index) => {
                    const row = `
                        <tr class="bg-white border-b hover:bg-gray-50">
                            <td class="px-6 py-4">${item.slNo}</td>
                            <td class="px-6 py-4 font-medium">${item.paymentNumber}</td>
                            <td class="px-6 py-4 font-medium">${item.transactionNumber}</td>
                            <td class="px-6 py-4">${item.vendorName}</td>
                            <td class="px-6 py-4">${item.bankName}</td>
                            <td class="px-6 py-4 font-mono">${item.accountNumber}</td>
                            <td class="px-6 py-4 font-mono">${item.pan}</td>
                            <td class="px-6 py-4">${item.invoiceNumber} dt : ${new Date(item.invoiceDate).toLocaleDateString('en-GB')}</td>
                            <td class="px-6 py-4 font-mono">${item.ifsc}</td>
                            <td class="px-6 py-4 font-medium text-green-600">₹${parseFloat(item.amount).toLocaleString('en-IN', {minimumFractionDigits: 2})}</td>
                            <td class="px-6 py-4 font-medium text-blue-600">₹${parseFloat(item.adjustment).toLocaleString('en-IN', {minimumFractionDigits: 2})}</td>
                            <td class="px-6 py-4 font-medium text-purple-600">₹${parseFloat(item.recoveries).toLocaleString('en-IN', {minimumFractionDigits: 2})}</td>
                            <td class="px-6 py-4 font-medium text-orange-600">₹${parseFloat(item.payable).toLocaleString('en-IN', {minimumFractionDigits: 2})}</td>
                            <td class="px-6 py-4">${item.employeeName}</td>
                            <td class="px-6 py-4">
                                <span class="remarks-text" title="${item.remarks || ''}">
                                    ${item.remarks && item.remarks.length > 30 ? item.remarks.substring(0, 30) + '...' : (item.remarks || '')}
                                </span>
                            </td>
                        </tr>
                    `;
                    tbody.insertAdjacentHTML('beforeend', row);
                });
            } else {
                tbody.insertAdjacentHTML('beforeend', `
                    <tr>
                        <td colspan="15" class="px-6 py-12 text-center">
                            <div class="text-gray-500">
                                <i class="ri-inbox-line text-4xl mb-4"></i>
                                <h5 class="text-lg font-medium">No Rent Payment data found</h5>
                                <p class="text-sm">Try adjusting your filter options to see more results.</p>
                            </div>
                        </td>
                    </tr>
                `);
            }
            
            $('#recordCount').text(data.totalRecords || 0);
        }

        function updateSummary(summary) {
            $('#totalPayments').text(summary.totalPayments || 0);
            $('#totalAmount').text('₹' + (parseFloat(summary.totalAmount || 0).toLocaleString('en-IN', {minimumFractionDigits: 2})));
            $('#totalPayable').text('₹' + (parseFloat(summary.totalPayable || 0).toLocaleString('en-IN', {minimumFractionDigits: 2})));
            $('#uniqueVendors').text(summary.uniqueVendors || 0);
        }

        function exportReport(format) {
            showLoading();
            
            // Get current form values
            const form = document.getElementById('rentPaymentReportForm');
            const formData = new FormData(form);
            
            // Add format and reset page to 0 for export (get all filtered data)
            formData.append('format', format);
            formData.append('Page', '0');
            
            // Create form for submission
            const exportForm = document.createElement('form');
            exportForm.method = 'POST';
            exportForm.action = '@Url.Action("Export", "RentPaymentReport")';
            
            // Add all form data as hidden inputs
            for (let [key, value] of formData.entries()) {
                const input = document.createElement('input');
                input.type = 'hidden';
                input.name = key;
                input.value = value;
                exportForm.appendChild(input);
            }
            
            // Ensure IncludeZeroAmounts checkbox value is properly set
            const includeZeroAmountsInput = document.createElement('input');
            includeZeroAmountsInput.type = 'hidden';
            includeZeroAmountsInput.name = 'IncludeZeroAmounts';
            includeZeroAmountsInput.value = document.getElementById('IncludeZeroAmounts').checked ? 'true' : 'false';
            exportForm.appendChild(includeZeroAmountsInput);
            
            document.body.appendChild(exportForm);
            exportForm.submit();
            document.body.removeChild(exportForm);
            
            setTimeout(() => {
                hideLoading();
                showToast('Export completed successfully!');
            }, 2000);
        }

        function showToast(message, type = 'success') {
            const toast = document.getElementById('toast');
            const toastMessage = document.getElementById('toastMessage');
            
            toast.className = `fixed bottom-6 right-6 px-6 py-3 rounded-lg shadow-lg z-50 transform transition-transform ${type === 'error' ? 'bg-red-600' : 'bg-primary'} text-white`;
            toastMessage.textContent = message;
            
            toast.classList.remove('hidden');
            toast.classList.add('translate-y-0');
            
            setTimeout(() => {
                toast.classList.add('hidden');
            }, 3000);
        }

        // Function to show remarks tooltip
        function showRemarksTooltip(element, text) {
            // Remove any existing tooltips
            $('.remarks-tooltip').remove();
            
            if (!text || text.length <= 30) return;
            
            const tooltip = $(`<div class="remarks-tooltip">${text}</div>`);
            $('body').append(tooltip);
            
            const rect = element.getBoundingClientRect();
            const tooltipRect = tooltip[0].getBoundingClientRect();
            
            // Position tooltip
            let left = rect.left + (rect.width / 2) - (tooltipRect.width / 2);
            let top = rect.top - tooltipRect.height - 10;
            
            // Adjust if tooltip goes off screen
            if (left < 10) left = 10;
            if (left + tooltipRect.width > window.innerWidth - 10) {
                left = window.innerWidth - tooltipRect.width - 10;
            }
            if (top < 10) {
                top = rect.bottom + 10;
                tooltip.find('::after').css('border-color', 'transparent transparent #1f2937 transparent');
            }
            
            tooltip.css({
                position: 'fixed',
                left: left + 'px',
                top: top + 'px',
                display: 'block'
            });
        }

        // Function to hide remarks tooltip
        function hideRemarksTooltip() {
            $('.remarks-tooltip').remove();
        }

        // Function to show remarks in modal
        function showRemarksModal(text) {
            if (!text || text.length <= 30) return;
            
            const modal = $(`
                <div class="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50" id="remarksModal">
                    <div class="bg-white rounded-lg p-6 max-w-2xl w-full mx-4">
                        <div class="flex items-center justify-between mb-4">
                            <h3 class="text-lg font-semibold">Remarks Details</h3>
                            <button onclick="closeRemarksModal()" class="text-gray-500 hover:text-gray-700">
                                <i class="ri-close-line text-xl"></i>
                            </button>
                        </div>
                        <div class="text-gray-700 whitespace-pre-wrap">${text}</div>
                        <div class="mt-6 flex justify-end">
                            <button onclick="closeRemarksModal()" class="bg-primary text-white px-4 py-2 rounded-lg hover:bg-primary/90">
                                Close
                            </button>
                        </div>
                    </div>
                </div>
            `);
            
            $('body').append(modal);
        }

        // Function to close remarks modal
        function closeRemarksModal() {
            $('#remarksModal').remove();
        }

        $(document).ready(function() {
            // Initialize pagination
            updatePagination(@Model.TotalRecords);
            
            // Set default date range if not set
            if (!$('#FromDate').val()) {
                $('#FromDate').val(new Date(Date.now() - 30 * 24 * 60 * 60 * 1000).toISOString().split('T')[0]);
            }
            if (!$('#ToDate').val()) {
                $('#ToDate').val(new Date().toISOString().split('T')[0]);
            }
            
            // Set default Financial Year to current year if not set
            if (!$('#FinancialYear').val()) {
                var currentYear = new Date().getFullYear();
                var currentFinancialYear = currentYear + '-' + (currentYear + 1).toString().substring(2);
                $('#FinancialYear').val(currentFinancialYear);
            }
            
            // Set default Month to current month if not set
            if (!$('#Month').val()) {
                var currentMonth = new Date().toLocaleString('en-US', { month: 'long' });
                $('#Month').val(currentMonth);
            }
            
            // Set default Payment Status to "All Status" if not set
            if (!$('#PaymentStatus').val()) {
                $('#PaymentStatus').val('');
            }
            
            // Show pagination if there are multiple pages
            if (@Model.TotalRecords > 20) {
                $('#paginationContainer').show();
            }

            // Add event handlers for remarks tooltips
            $(document).on('mouseenter', '.remarks-text', function() {
                const fullText = $(this).attr('title');
                showRemarksTooltip(this, fullText);
            });

            $(document).on('mouseleave', '.remarks-text', function() {
                hideRemarksTooltip();
            });

            $(document).on('click', '.remarks-text', function() {
                const fullText = $(this).attr('title');
                showRemarksModal(fullText);
            });

            // Close modal when clicking outside
            $(document).on('click', '#remarksModal', function(e) {
                if (e.target === this) {
                    closeRemarksModal();
                }
            });
        });
    </script>
}
