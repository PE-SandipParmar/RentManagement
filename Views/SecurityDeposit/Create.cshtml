@model RentManagement.Models.SecurityDeposit

@{
    ViewData["Title"] = "Create Security Deposit";
}

<link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
<style>
    .select2-container--default .select2-selection--single {
        height: 42px;
        border: 1px solid #d1d5db;
        border-radius: 0.375rem;
        padding: 6px 12px;
    }

        .select2-container--default .select2-selection--single .select2-selection__rendered {
            color: #374151;
            line-height: 28px;
        }

        .select2-container--default .select2-selection--single .select2-selection__arrow {
            height: 40px;
        }

    .error-message {
        color: #dc2626;
        font-size: 0.875rem;
        margin-top: 0.25rem;
    }

    .success-message {
        color: #16a34a;
        font-size: 0.875rem;
        margin-top: 0.25rem;
    }

    .info-text {
        color: #6b7280;
        font-size: 0.75rem;
        margin-top: 0.25rem;
    }

    .validation-error {
        border-color: #dc2626 !important;
    }

    .validation-success {
        border-color: #16a34a !important;
    }

    .warning-box {
        background-color: #fef3cd;
        border: 1px solid #ffc107;
        border-radius: 0.375rem;
        padding: 1rem;
        margin: 1rem 0;
    }

    .warning-text {
        color: #856404;
        font-weight: 500;
    }

    /* Select2 validation styling */
    .select2-container--default.validation-error .select2-selection--single {
        border-color: #dc2626 !important;
    }

    .select2-container--default.validation-success .select2-selection--single {
        border-color: #16a34a !important;
    }

    .required-field {
        border: 2px solid transparent;
    }

    .field-validation-error {
        color: #dc2626;
        font-size: 0.875rem;
        margin-top: 0.25rem;
        display: block;
    }
</style>

<div class="max-w-4xl mx-auto">
    <div class="bg-white shadow rounded-lg">
        <div class="px-6 py-4 border-b border-gray-200">
            <h1 class="text-2xl font-bold text-gray-900">Create Security Deposit</h1>
        </div>

        <form asp-action="Create" method="post" id="securityDepositForm" class="px-6 py-4 space-y-6" novalidate>
            <div asp-validation-summary="ModelOnly" class="text-red-600"></div>

            <!-- Duplicate Warning -->
            <div id="duplicateWarning" class="warning-box" style="display: none;">
                <div class="warning-text">
                    <strong>Warning:</strong> <span id="duplicateMessage"></span>
                </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                    <label asp-for="EmployeeId" class="block text-sm font-medium text-gray-700 mb-1">Employee Name <span class="text-red-500">*</span></label>
                    <select asp-for="EmployeeId" id="employeeSelect" class="searchable-dropdown required-field w-full px-3 py-2 border border-gray-300 rounded-md"
                            asp-items="@(new SelectList(ViewBag.Employees, "Id", "Name"))" required>
                        <option value="">Select Employee</option>
                    </select>
                    <span asp-validation-for="EmployeeId" class="field-validation-error"></span>
                    <div id="employeeValidation" class="error-message" style="display: none;">Please select an employee</div>
                    <div id="employeeSalaryInfo" class="info-text" style="display: none;"></div>
                </div>
                <div>
                    <label asp-for="VendorId" class="block text-sm font-medium text-gray-700 mb-1">Owner Name <span class="text-red-500">*</span></label>
                    <select asp-for="VendorId" id="vendorSelect" class="searchable-dropdown required-field w-full px-3 py-2 border border-gray-300 rounded-md" disabled required
                            asp-items="@(new SelectList(ViewBag.Vendors, "Id", "Name"))">
                        <option value="">Select Owner</option>
                    </select>
                    <span asp-validation-for="VendorId" class="field-validation-error"></span>
                    <div id="vendorValidation" class="error-message" style="display: none;">Please select an owner</div>
                    <div class="info-text">Owner will be auto-selected based on Employee and Lease</div>
                </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                    <label asp-for="LeaseId" class="block text-sm font-medium text-gray-700 mb-1">Lease Reference <span class="text-red-500">*</span></label>
                    <select asp-for="LeaseId" id="leaseSelect" class="searchable-dropdown required-field w-full px-3 py-2 border border-gray-300 rounded-md" disabled required
                            asp-items="@(new SelectList(ViewBag.Leases, "Id", "Name"))">
                        <option value="">Select Lease</option>
                    </select>
                    <span asp-validation-for="LeaseId" class="field-validation-error"></span>
                    <div id="leaseValidation" class="error-message" style="display: none;">Please select a lease</div>
                    <div class="info-text">Please select Employee first</div>
                </div>
                <div>
                    <label asp-for="Amount" class="block text-sm font-medium text-gray-700 mb-1">Deposit Amount <span class="text-red-500">*</span></label>
                    <input asp-for="Amount" id="amountInput" class="required-field w-full px-3 py-2 border border-gray-300 rounded-md"
                           type="number" step="0.01" min="0.01" placeholder="Enter deposit amount" required />
                    <span asp-validation-for="Amount" class="field-validation-error"></span>
                    <div id="amountValidation" class="info-text"></div>
                    <div id="maxAmountInfo" class="info-text" style="display: none;"></div>
                </div>
            </div>

            <!-- TDS Fields Row -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                    <label asp-for="TdsRate" class="block text-sm font-medium text-gray-700 mb-1">
                        TDS Applicable <span class="text-xs text-gray-500">(Optional)</span>
                    </label>
                    <select asp-for="TdsRate" id="tdsRateSelect" class="searchable-dropdown w-full px-3 py-2 border border-gray-300 rounded-md">
                        <option value="0" data-rate="0">No TDS</option>
                        <option value="2" data-rate="2">TDS 2%</option>
                        <option value="10" data-rate="10">TDS 10%</option>
                        <option value="20" data-rate="20">TDS 20%</option>
                    </select>
                    <span asp-validation-for="TdsRate" class="field-validation-error"></span>
                    <div class="info-text">Select applicable TDS rate or leave as 'No TDS'</div>
                </div>
                <div>
                    <label asp-for="TdsAmount" class="block text-sm font-medium text-gray-700 mb-1">TDS Amount</label>
                    <input asp-for="TdsAmount" id="tdsAmountInput" class="w-full px-3 py-2 border border-gray-300 rounded-md bg-gray-50" type="number" step="0.01" readonly />
                    <span asp-validation-for="TdsAmount" class="field-validation-error"></span>
                    <div id="tdsCalculation" class="info-text">Auto-calculated based on Deposit Amount and TDS Rate</div>
                </div>
            </div>

            <!-- Net Amount Display -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Net Amount (After TDS)</label>
                    <div class="w-full px-3 py-2 border border-gray-200 rounded-md bg-gray-50 text-lg font-semibold text-green-600" id="netAmountDisplay">
                        ₹0.00
                    </div>
                    <div class="info-text">Amount payable after TDS deduction</div>
                </div>
                <div style="display:none">
                    <label asp-for="ApprovalStatus" class="block text-sm font-medium text-gray-700 mb-1">Approval Status</label>
                    <select asp-for="ApprovalStatus" class="searchable-dropdown w-full px-3 py-2 border border-gray-300 rounded-md">
                        <option value="Pending">Pending</option>
                        <option value="Approved">Approved</option>
                        <option value="Rejected">Rejected</option>
                    </select>
                    <span asp-validation-for="ApprovalStatus" class="field-validation-error"></span>
                </div>
            </div>

            <div>
                <label asp-for="Remark" class="block text-sm font-medium text-gray-700 mb-1">Remarks</label>
                <textarea asp-for="Remark" rows="3"
                          class="w-full px-3 py-2 border border-gray-300 rounded-md resize-none"
                          placeholder="Enter any additional remarks..."></textarea>
                <span asp-validation-for="Remark" class="field-validation-error"></span>
            </div>

            <div class="flex justify-end space-x-3">
                <button type="submit" id="submitBtn" class="px-4 py-2 text-sm font-medium text-white bg-blue-600 rounded-md hover:bg-blue-700 disabled:bg-gray-400 disabled:cursor-not-allowed">
                    Create Security Deposit
                </button>
                <a href="@Url.Action("Index")" class="px-4 py-2 text-sm font-medium text-gray-700 bg-gray-200 rounded-md hover:bg-gray-300">
                    Cancel
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
<script>
    $(document).ready(function () {
        // Initialize Select2
        $('.searchable-dropdown').select2({
            placeholder: "Select an option",
            allowClear: true,
            width: '100%'
        });

        let employeeSalary = 0;
        let maxSecurityDeposit = 0;

        // Real-time validation for required fields
        function validateRequiredField(fieldId, validationId, errorMessage) {
            const field = $(fieldId);
            const validation = $(validationId);
            const value = field.val();

            if (!value || value === "") {
                field.addClass('validation-error').removeClass('validation-success');
                // For Select2 dropdowns
                if (field.hasClass('searchable-dropdown')) {
                    field.next('.select2-container').addClass('validation-error').removeClass('validation-success');
                }
                validation.text(errorMessage).show();
                return false;
            } else {
                field.addClass('validation-success').removeClass('validation-error');
                // For Select2 dropdowns
                if (field.hasClass('searchable-dropdown')) {
                    field.next('.select2-container').addClass('validation-success').removeClass('validation-error');
                }
                validation.hide();
                return true;
            }
        }

        // Employee validation
        $('#employeeSelect').on('change', function () {
            const isValid = validateRequiredField('#employeeSelect', '#employeeValidation', 'Please select an employee');
            const employeeId = $(this).val();

            if (employeeId && isValid) {
                // Enable lease dropdown
                $('#leaseSelect').prop('disabled', false);

                // Fetch employee salary and leases
                fetchEmployeeData(employeeId);
                fetchEmployeeLeases(employeeId);

                // Reset vendor selection
                $('#vendorSelect').val('').trigger('change');
                $('#duplicateWarning').hide();
            } else {
                // Reset everything
                resetForm();
            }
        });

        // Vendor validation
        $('#vendorSelect').on('change', function () {
            validateRequiredField('#vendorSelect', '#vendorValidation', 'Please select an owner');

            const employeeId = $('#employeeSelect').val();
            const leaseId = $('#leaseSelect').val();

            if (employeeId && leaseId && $(this).val()) {
                checkDuplicateRecord(employeeId, leaseId);
            }
        });

        // Lease validation
        $('#leaseSelect').on('change', function () {
            const isValid = validateRequiredField('#leaseSelect', '#leaseValidation', 'Please select a lease');
            const leaseId = $(this).val();
            const employeeId = $('#employeeSelect').val();

            if (leaseId && employeeId && isValid) {
                // Auto-fetch owner based on lease
                fetchLeaseOwner(leaseId);

                // Check for duplicate records
                checkDuplicateRecord(employeeId, leaseId);
            } else {
                $('#vendorSelect').val('').trigger('change').prop('disabled', true);
                $('#duplicateWarning').hide();
            }
        });

        // Amount validation
        $('#amountInput').on('input blur', function () {
            validateAmount();
            calculateTds();
        });

        // Amount change - recalculate TDS
        $('#amountInput').on('input blur', function () {
            validateAmount();
            calculateTds();
        });

        // TDS Rate change - recalculate TDS
        $('#tdsRateSelect').on('change', function () {
            const selectedOption = $(this).find('option:selected');
            const rate = parseFloat(selectedOption.data('rate')) || 0;

            // Visual feedback
            if (rate > 0) {
                $(this).removeClass('validation-error').addClass('validation-success');
            } else {
                $(this).removeClass('validation-error validation-success');
            }

            calculateTds();
        });

        function calculateTds() {
            const amount = parseFloat($('#amountInput').val()) || 0;
            const selectedOption = $('#tdsRateSelect option:selected');
            const tdsRate = parseFloat(selectedOption.data('rate')) || 0;

            let tdsAmount = 0;
            if (amount > 0 && tdsRate > 0) {
                tdsAmount = (amount * tdsRate) / 100;
                $('#tdsAmountInput').val(tdsAmount.toFixed(2));
                $('#tdsCalculation').removeClass('error-message').addClass('success-message')
                    .text(`TDS: ₹${tdsAmount.toLocaleString()} (${tdsRate}% of ₹${amount.toLocaleString()})`);
            } else {
                $('#tdsAmountInput').val('0.00');
                $('#tdsCalculation').removeClass('error-message success-message')
                    .text('Auto-calculated based on Deposit Amount and TDS Rate');
            }

            // Update net amount display
            const netAmount = amount - tdsAmount;
            $('#netAmountDisplay').text(`₹${netAmount.toLocaleString()}`);
        }

        // Form submission validation
        $('#securityDepositForm').on('submit', function (e) {
            if (!validateForm()) {
                e.preventDefault();
                scrollToFirstError();
                return false;
            }
        });

        // Functions
        function fetchEmployeeData(employeeId) {
            $.ajax({
                url: '@Url.Action("GetEmployeeSalary", "SecurityDeposit")',
                type: 'GET',
                data: { employeeId: employeeId },
                success: function (data) {
                    if (data.success) {
                        employeeSalary = data.salary;
                        maxSecurityDeposit = employeeSalary * 2;

                        validateAmount();
                    }
                },
                error: function () {
                    showError('Error fetching employee salary information');
                }
            });
        }

        function fetchEmployeeLeases(employeeId) {
            $.ajax({
                url: '@Url.Action("GetEmployeeLeases", "SecurityDeposit")',
                type: 'GET',
                data: { employeeId: employeeId },
                success: function (data) {
                    const leaseSelect = $('#leaseSelect');
                    leaseSelect.empty().append('<option value="">Select Lease</option>');

                    if (data && data.length > 0) {
                        $.each(data, function (i, lease) {
                            leaseSelect.append(`<option value="${lease.id}">${lease.name}</option>`);
                        });
                    } else {
                        leaseSelect.append('<option value="">No leases found for this employee</option>');
                    }
                },
                error: function () {
                    showError('Error fetching employee leases');
                }
            });
        }

        function fetchLeaseOwner(leaseId) {
            $.ajax({
                url: '@Url.Action("GetLeaseOwner", "SecurityDeposit")',
                type: 'GET',
                data: { leaseId: leaseId },
                success: function (data) {
                    if (data.success) {
                        $('#vendorSelect').val(data.ownerId).trigger('change').prop('disabled', true);
                        // Validate the auto-selected vendor
                        validateRequiredField('#vendorSelect', '#vendorValidation', 'Please select an owner');
                    }
                },
                error: function () {
                    showError('Error fetching lease owner information');
                }
            });
        }

        function checkDuplicateRecord(employeeId, leaseId) {
            const vendorId = $('#vendorSelect').val();

            if (employeeId && leaseId && vendorId) {
                $.ajax({
                    url: '@Url.Action("CheckDuplicateRecord", "SecurityDeposit")',
                    type: 'GET',
                    data: {
                        employeeId: employeeId,
                        leaseId: leaseId,
                        vendorId: vendorId
                    },
                    success: function (data) {
                        if (data.isDuplicate) {
                            $('#duplicateWarning').show();
                            $('#duplicateMessage').text(
                                'A security deposit record already exists for this Employee + Lease + Owner combination.'
                            );
                            $('#submitBtn').prop('disabled', true);
                        } else {
                            $('#duplicateWarning').hide();
                            $('#submitBtn').prop('disabled', false);
                        }
                    },
                    error: function () {
                        console.error('Error checking duplicate records');
                    }
                });
            }
        }

        function validateAmount() {
            const amount = parseFloat($('#amountInput').val()) || 0;
            const amountInput = $('#amountInput');
            const validation = $('#amountValidation');

            // Clear previous validation
            amountInput.removeClass('validation-error validation-success');
            validation.removeClass('error-message success-message');

            if (amount <= 0) {
                amountInput.addClass('validation-error');
                validation.addClass('error-message').text('Deposit amount is required and must be greater than 0');
                return false;
            }

            // Valid amount
            amountInput.addClass('validation-success');
            validation.addClass('success-message').text('Valid amount');
            return true;
        }

        function validateForm() {
            let isValid = true;

            // Validate Employee
            if (!validateRequiredField('#employeeSelect', '#employeeValidation', 'Please select an employee')) {
                isValid = false;
            }

            // Validate Vendor
            if (!validateRequiredField('#vendorSelect', '#vendorValidation', 'Please select an owner')) {
                isValid = false;
            }

            // Validate Lease
            if (!validateRequiredField('#leaseSelect', '#leaseValidation', 'Please select a lease')) {
                isValid = false;
            }

            // Validate Amount
            if (!validateAmount()) {
                isValid = false;
            }

            // Check for duplicates
            if ($('#duplicateWarning').is(':visible')) {
                isValid = false;
                showError('Please resolve the duplicate record warning before submitting.');
            }

            if (!isValid) {
                showError('Please fill in all required fields marked with * before submitting.');
            }

            return isValid;
        }

        function scrollToFirstError() {
            const firstError = $('.validation-error').first();
            if (firstError.length) {
                $('html, body').animate({
                    scrollTop: firstError.offset().top - 100
                }, 500);
                firstError.focus();
            }
        }

        function resetForm() {
            $('#leaseSelect').prop('disabled', true).val('').trigger('change');
            $('#vendorSelect').prop('disabled', true).val('').trigger('change');
            $('#employeeSalaryInfo, #maxAmountInfo').hide();
            $('#duplicateWarning').hide();
            $('#amountInput, #tdsRateSelect, #tdsAmountInput').val('').removeClass('validation-error validation-success');
            $('#amountValidation, #tdsCalculation').text('').removeClass('error-message success-message');
            $('#netAmountDisplay').text('₹0.00');

            // Hide all validation messages
            $('#employeeValidation, #vendorValidation, #leaseValidation').hide();

            // Reset Select2 containers
            $('.select2-container').removeClass('validation-error validation-success');

            employeeSalary = 0;
            maxSecurityDeposit = 0;
        }

        function showError(message) {
            // Create or update a general error message container
            let errorContainer = $('#generalErrorMessage');
            if (errorContainer.length === 0) {
                errorContainer = $('<div id="generalErrorMessage" class="error-message" style="padding: 10px; margin: 10px 0; border-left: 4px solid #dc2626; background-color: #fef2f2;"></div>');
                $('#securityDepositForm').prepend(errorContainer);
            }
            errorContainer.html('<strong>Error:</strong> ' + message).show();

            // Auto-hide after 5 seconds
            setTimeout(function () {
                errorContainer.fadeOut();
            }, 5000);

            // Scroll to top to show the error
            $('html, body').animate({
                scrollTop: errorContainer.offset().top - 50
            }, 300);
        }

        // Initial calculation
        calculateTds();

        // Initialize validation state
        $('#submitBtn').prop('disabled', false);
    });
</script>