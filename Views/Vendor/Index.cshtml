        // Form validation
        function initializeValidation() {
            // PAN Number validation
            document.querySelectorAll('input[name="panNumber"]').forEach(input => {
                input.addEventListener('input', function () {
                    this.value = this.value.toUpperCase().replace(/[^A-Z0-9]/g, '');
