        // Validation functions
        function validatePANNumber(input) {
            const value = input.value.trim();

            // If empty and not required, it's valid
            if (!value) {
                if (!input.hasAttribute('required')) {
                    clearFieldError(input);
                  //  return true;
                } else {
                    showFieldError(input, 'PAN Number is required');
                    return false;
                }
            }

            // Check length first
            if (value.length !== 10) {
                showFieldError(input, 'PAN Number must be exactly 10 characters');
                return false;
            }

            // Validate PAN format: 5 letters + 4 digits + 1 letter
            const panPattern = /^[A-Z]{5}[0-9]{4}[A-Z]{1}$/;
            if (!panPattern.test(value)) {
                showFieldError(input, 'Invalid PAN format. Must be: 5 letters + 4 digits + 1 letter (e.g., ABCDE1234F)');
                return false;
            }

            clearFieldError(input);
            return true;
        }

        function validateGSTNumber(input) {
            const value = input.value.trim();

            // If empty, it's valid (GST Number is not required)
            if (!value) {
                clearFieldError(input);
                return true;
            }

            // Check length first
            if (value.length !== 15) {
                showFieldError(input, 'GST Number must be exactly 15 characters');
                return false;
            }

            // Validate GST format: 2 digits + 5 letters + 4 digits + 1 letter + Z + 1 alphanumeric
            const gstPattern = /^[0-9]{2}[A-Z]{5}[0-9]{4}[A-Z]{1}[1-9A-Z]{1}Z[A-Z0-9]{1}$/;
            if (!gstPattern.test(value)) {
                showFieldError(input, 'Invalid GST Number format. Format: 22AAAAA0000A1Z5');
                return false;
            }

            clearFieldError(input);
            return true;
        }

        function validateMobileNumber(input) {
            const mobilePattern = /^[0-9]{10}$/;
            if (input.value && !mobilePattern.test(input.value)) {
                const fieldName = input.name === 'mobileNumber' ? 'Mobile Number' : 'Alternate Number';
                showFieldError(input, `${fieldName} must be 10 digits`);
                return false;
            }
            clearFieldError(input);
            return true;
        }
        1
        function validateIFSCCode1(input) {
            const ifscPattern = /^[A-Z]{4}[0-9]{7}$/;
            if (input.value && !ifscPattern.test(input.value)) {
                showFieldError(input, 'Invalid IFSC Code format (e.g., SBIN0001234)');
                return false;
            } else if (input.value && input.value.length !== 11) {
                showFieldError(input, 'IFSC Code must be 11 characters');
                return false;
            }
            clearFieldError(input);
            return true;
        }

        function validateEmail(input) {
            const emailPattern = /^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/;
            if (input.value && !emailPattern.test(input.value)) {
                showFieldError(input, 'Invalid email format');
                return false;
            }
            clearFieldError(input);
            return true;
        }

        function validateRequired(input) {
            if (input.hasAttribute('required') && !input.value.trim()) {
                const label = input.closest('div').querySelector('label').textContent.replace('*', '').trim();
                showFieldError(input, `${label} is required`);
                return false;
            }
            clearFieldError(input);
            return true;
        }

        function showFieldError(input, message) {
            // Handle radio button groups
            if (input.type === 'radio') {
                const errorDiv = input.parentNode.parentNode.querySelector(`[data-field="${input.name}"]`);
                if (errorDiv) {
                    errorDiv.textContent = message;
                    errorDiv.classList.remove('hidden');
                    // Add error styling to the radio button container
                    input.parentNode.parentNode.classList.add('error-input');
                }
            } else {
            const errorDiv = input.parentNode.querySelector(`[data-field="${input.name}"]`);
            if (errorDiv) {
                errorDiv.textContent = message;
                errorDiv.classList.remove('hidden');
                input.classList.add('error-input');
                }
            }
        }

        function clearFieldError(input) {
            // Handle radio button groups
            if (input.type === 'radio') {
                const errorDiv = input.parentNode.parentNode.querySelector(`[data-field="${input.name}"]`);
                if (errorDiv) {
                    errorDiv.classList.add('hidden');
                    // Remove error styling from the radio button container
                    input.parentNode.parentNode.classList.remove('error-input');
                }
            } else {
            const errorDiv = input.parentNode.querySelector(`[data-field="${input.name}"]`);
            if (errorDiv) {
                errorDiv.classList.add('hidden');
                input.classList.remove('error-input');
                }
            }
        }

