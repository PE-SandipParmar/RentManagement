@model RentManagement.Models.LeaseReportModel
@{
    ViewData["Title"] = "Lease Report";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="min-h-screen bg-gray-50 py-8">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <!-- Header -->
        <div class="mb-8">
            <div class="flex items-center justify-between">
                <div>
                    <h1 class="text-3xl font-bold text-gray-900">@Model.ReportTitle</h1>
                    <p class="mt-2 text-gray-600">Comprehensive lease management report with detailed analytics</p>
                </div>
                <div class="flex space-x-3">
                    <button id="exportBtn" class="inline-flex items-center px-4 py-2 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50">
                        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                        </svg>
                        Export
                    </button>
                    <button id="refreshBtn" class="inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md text-white bg-blue-600 hover:bg-blue-700">
                        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
                        </svg>
                        Refresh
                    </button>
                </div>
            </div>
        </div>

        <!-- Summary Cards -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
            <div class="bg-white rounded-lg shadow p-6">
                <div class="flex items-center">
                    <div class="flex-shrink-0">
                        <svg class="h-8 w-8 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                        </svg>
                    </div>
                    <div class="ml-4">
                        <p class="text-sm font-medium text-gray-500">Total Leases</p>
                        <p class="text-2xl font-semibold text-gray-900">@Model.TotalRecords</p>
                    </div>
                </div>
            </div>

            <div class="bg-white rounded-lg shadow p-6">
                <div class="flex items-center">
                    <div class="flex-shrink-0">
                        <svg class="h-8 w-8 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                        </svg>
                    </div>
                    <div class="ml-4">
                        <p class="text-sm font-medium text-gray-500">Active Leases</p>
                        <p class="text-2xl font-semibold text-gray-900">@Model.ActiveLeases</p>
                    </div>
                </div>
            </div>

            <div class="bg-white rounded-lg shadow p-6">
                <div class="flex items-center">
                    <div class="flex-shrink-0">
                        <svg class="h-8 w-8 text-yellow-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1"></path>
                        </svg>
                    </div>
                    <div class="ml-4">
                        <p class="text-sm font-medium text-gray-500">Monthly Rent</p>
                        <p class="text-2xl font-semibold text-gray-900">₹@Model.TotalMonthlyRent.ToString("N0")</p>
                    </div>
                </div>
            </div>

            <div class="bg-white rounded-lg shadow p-6">
                <div class="flex items-center">
                    <div class="flex-shrink-0">
                        <svg class="h-8 w-8 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L3.732 16.5c-.77.833.192 2.5 1.732 2.5z"></path>
                        </svg>
                    </div>
                    <div class="ml-4">
                        <p class="text-sm font-medium text-gray-500">Pending Approvals</p>
                        <p class="text-2xl font-semibold text-gray-900">@Model.PendingApprovals</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Filters -->
        <div class="bg-white rounded-lg shadow mb-8">
            <div class="px-6 py-4 border-b border-gray-200">
                <h3 class="text-lg font-medium text-gray-900">Filters</h3>
            </div>
            <div class="p-6">
                <form id="filterForm" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">From Date</label>
                        <input type="date" name="FromDate" class="w-full px-3 py-2 border border-gray-300 rounded-md" value="@(Model.FromDate?.ToString("yyyy-MM-dd"))" />
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">To Date</label>
                        <input type="date" name="ToDate" class="w-full px-3 py-2 border border-gray-300 rounded-md" value="@(Model.ToDate?.ToString("yyyy-MM-dd"))" />
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Employee</label>
                        <select name="EmployeeId" class="w-full px-3 py-2 border border-gray-300 rounded-md">
                            <option value="">All Employees</option>
                            @if (ViewBag.Employees != null)
                            {
                                foreach (var employee in ViewBag.Employees)
                                {
                                    <option value="@employee.Id">@employee.Name</option>
                                }
                            }
                        </select>
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Vendor</label>
                        <select name="VendorId" class="w-full px-3 py-2 border border-gray-300 rounded-md">
                            <option value="">All Vendors</option>
                            @if (ViewBag.Vendors != null)
                            {
                                foreach (var vendor in ViewBag.Vendors)
                                {
                                    <option value="@vendor.Id">@vendor.VendorName</option>
                                }
                            }
                        </select>
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Lease Type</label>
                        <select name="LeaseTypeId" class="w-full px-3 py-2 border border-gray-300 rounded-md">
                            <option value="">All Types</option>
                            @if (ViewBag.LeaseTypes != null)
                            {
                                foreach (var leaseType in ViewBag.LeaseTypes)
                                {
                                    <option value="@leaseType.Id">@leaseType.Name</option>
                                }
                            }
                        </select>
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Status</label>
                        <select name="Status" class="w-full px-3 py-2 border border-gray-300 rounded-md">
                            <option value="">All Status</option>
                            @if (ViewBag.StatusOptions != null)
                            {
                                foreach (var status in ViewBag.StatusOptions)
                                {
                                    <option value="@status.Value">@status.Text</option>
                                }
                            }
                        </select>
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Approval Status</label>
                        <select name="ApprovalStatus" class="w-full px-3 py-2 border border-gray-300 rounded-md">
                            <option value="">All Approvals</option>
                            @if (ViewBag.ApprovalStatusOptions != null)
                            {
                                foreach (var approvalStatus in ViewBag.ApprovalStatusOptions)
                                {
                                    <option value="@approvalStatus.Value">@approvalStatus.Text</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="lg:col-span-2 flex items-end space-x-3">
                        <button type="submit" class="flex-1 bg-blue-600 text-white px-4 py-2 rounded-md hover:bg-blue-700">
                            Apply Filters
                        </button>
                        <button type="button" id="clearFilters" class="px-4 py-2 border border-gray-300 text-gray-700 rounded-md hover:bg-gray-50">
                            Clear
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <!-- Report Data -->
        <div class="bg-white rounded-lg shadow">
            <div class="px-6 py-4 border-b border-gray-200">
                <div class="flex items-center justify-between">
                    <h3 class="text-lg font-medium text-gray-900">Lease Data</h3>
                    <div class="flex items-center space-x-3">
                        <select id="exportFormat" class="px-3 py-1 border border-gray-300 rounded-md text-sm">
                            <option value="PDF">PDF</option>
                            <option value="Excel">Excel</option>
                            <option value="CSV">CSV</option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="overflow-x-auto">
                <table class="min-w-full divide-y divide-gray-200">
                    <thead class="bg-gray-50">
                        <tr>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Ref No</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Employee</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Vendor</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Lease Type</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Monthly Rent</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Rent Amount</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Maintenance</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">From Date</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">End Date</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Approval</th>
                        </tr>
                    </thead>
                    <tbody class="bg-white divide-y divide-gray-200" id="reportTableBody">
                        @if (Model.Leases != null && Model.Leases.Any())
                        {
                            foreach (var lease in Model.Leases)
                            {
                                <tr class="hover:bg-gray-50">
                                    <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">@lease.RefNo</td>
                                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">@lease.EmployeeName</td>
                                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">@lease.VendorName</td>
                                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">@lease.LeaseTypeName</td>
                                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">₹@(lease.MonthlyRentPayable?.ToString("N0") ?? "0")</td>
                                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">₹@(lease.RentAmount?.ToString("N0") ?? "0")</td>
                                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">₹@(lease.MaintenancePayment?.ToString("N0") ?? "0")</td>
                                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">@(lease.FromDate?.ToString("dd/MM/yyyy") ?? "-")</td>
                                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">@(lease.EndDate?.ToString("dd/MM/yyyy") ?? "-")</td>
                                    <td class="px-6 py-4 whitespace-nowrap">
                                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium @GetStatusColor(lease.Status)">
                                            @lease.Status
                                        </span>
                                    </td>
                                    <td class="px-6 py-4 whitespace-nowrap">
                                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium @GetApprovalStatusColor(lease.ApprovalStatus)">
                                            @lease.ApprovalStatus
                                        </span>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="11" class="px-6 py-4 text-center text-gray-500">No lease data found</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Report Footer -->
        <div class="mt-6 bg-white rounded-lg shadow p-6">
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6 text-sm text-gray-600">
                <div>
                    <p><strong>Generated:</strong> @Model.GeneratedDate.ToString("dd/MM/yyyy HH:mm")</p>
                    <p><strong>Generated By:</strong> @Model.GeneratedBy</p>
                </div>
                <div>
                    <p><strong>Total Records:</strong> @Model.TotalRecords</p>
                    <p><strong>Report Type:</strong> @Model.ReportType</p>
                </div>
                <div>
                    <p><strong>Date Range:</strong> @(Model.FromDate?.ToString("dd/MM/yyyy") ?? "All") - @(Model.ToDate?.ToString("dd/MM/yyyy") ?? "All")</p>
                </div>
            </div>
        </div>
    </div>
</div>

@functions {
    private string GetStatusColor(string status)
    {
        return status?.ToLower() switch
        {
            "active" => "bg-green-100 text-green-800",
            "expired" => "bg-red-100 text-red-800",
            "terminated" => "bg-gray-100 text-gray-800",
            _ => "bg-gray-100 text-gray-800"
        };
    }

    private string GetApprovalStatusColor(string approvalStatus)
    {
        return approvalStatus?.ToLower() switch
        {
            "approved" => "bg-green-100 text-green-800",
            "pending" => "bg-yellow-100 text-yellow-800",
            "rejected" => "bg-red-100 text-red-800",
            _ => "bg-gray-100 text-gray-800"
        };
    }
}

@section Scripts {
    <script>
        $(document).ready(function() {
            // Filter form submission
            $('#filterForm').on('submit', function(e) {
                e.preventDefault();
                loadReportData();
            });

            // Clear filters
            $('#clearFilters').on('click', function() {
                $('#filterForm')[0].reset();
                loadReportData();
            });

            // Refresh button
            $('#refreshBtn').on('click', function() {
                loadReportData();
            });

            // Export button
            $('#exportBtn').on('click', function() {
                exportReport();
            });
        });

        function loadReportData() {
            const formData = new FormData($('#filterForm')[0]);
            const params = new URLSearchParams(formData);

            $.ajax({
                url: '@Url.Action("Lease", "Report")',
                type: 'GET',
                data: params,
                headers: {
                    'X-Requested-With': 'XMLHttpRequest'
                },
                success: function(response) {
                    if (response.success) {
                        updateReportData(response.data);
                    } else {
                        alert('Error loading report data');
                    }
                },
                error: function() {
                    alert('Error loading report data');
                }
            });
        }

        function updateReportData(data) {
            // Update summary cards
            $('.text-2xl').each(function() {
                const text = $(this).text();
                if (text.includes('Total Leases')) {
                    $(this).text(data.totalRecords);
                } else if (text.includes('Active Leases')) {
                    $(this).text(data.activeLeases);
                } else if (text.includes('Monthly Rent')) {
                    $(this).text('₹' + data.totalMonthlyRent.toLocaleString());
                } else if (text.includes('Pending Approvals')) {
                    $(this).text(data.pendingApprovals);
                }
            });

            // Update table
            const tbody = $('#reportTableBody');
            if (data.leases && data.leases.length > 0) {
                const html = data.leases.map(lease => `
                    <tr class="hover:bg-gray-50">
                        <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">${lease.refNo}</td>
                        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">${lease.employeeName}</td>
                        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">${lease.vendorName}</td>
                        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">${lease.leaseTypeName}</td>
                        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">₹${(lease.monthlyRentPayable || 0).toLocaleString()}</td>
                        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">₹${(lease.rentAmount || 0).toLocaleString()}</td>
                        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">₹${(lease.maintenancePayment || 0).toLocaleString()}</td>
                        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">${lease.fromDate ? new Date(lease.fromDate).toLocaleDateString() : '-'}</td>
                        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">${lease.endDate ? new Date(lease.endDate).toLocaleDateString() : '-'}</td>
                        <td class="px-6 py-4 whitespace-nowrap">
                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium ${getStatusColor(lease.status)}">
                                ${lease.status}
                            </span>
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap">
                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium ${getApprovalStatusColor(lease.approvalStatus)}">
                                ${lease.approvalStatus}
                            </span>
                        </td>
                    </tr>
                `).join('');
                tbody.html(html);
            } else {
                tbody.html('<tr><td colspan="11" class="px-6 py-4 text-center text-gray-500">No lease data found</td></tr>');
            }
        }

        function exportReport() {
            const formData = new FormData($('#filterForm')[0]);
            formData.append('reportType', 'lease');
            formData.append('ReportFormat', $('#exportFormat').val());

            $.ajax({
                url: '@Url.Action("Export", "Report")',
                type: 'POST',
                data: formData,
                processData: false,
                contentType: false,
                xhrFields: {
                    responseType: 'blob'
                },
                success: function(blob) {
                    const url = window.URL.createObjectURL(blob);
                    const a = document.createElement('a');
                    a.href = url;
                    a.download = `Lease_Report_${new Date().toISOString().slice(0, 10)}.${$('#exportFormat').val().toLowerCase()}`;
                    document.body.appendChild(a);
                    a.click();
                    window.URL.revokeObjectURL(url);
                    document.body.removeChild(a);
                },
                error: function() {
                    alert('Error exporting report');
                }
            });
        }

        function getStatusColor(status) {
            switch (status?.toLowerCase()) {
                case 'active':
                    return 'bg-green-100 text-green-800';
                case 'expired':
                    return 'bg-red-100 text-red-800';
                case 'terminated':
                    return 'bg-gray-100 text-gray-800';
                default:
                    return 'bg-gray-100 text-gray-800';
            }
        }

        function getApprovalStatusColor(approvalStatus) {
            switch (approvalStatus?.toLowerCase()) {
                case 'approved':
                    return 'bg-green-100 text-green-800';
                case 'pending':
                    return 'bg-yellow-100 text-yellow-800';
                case 'rejected':
                    return 'bg-red-100 text-red-800';
                default:
                    return 'bg-gray-100 text-gray-800';
            }
        }
    </script>
}
