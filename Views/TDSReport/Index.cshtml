@model TDSReportModel
@{
    ViewData["Title"] = "TDS Report - Lease Payable";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .gradient-bg {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    }
    .glass-effect {
        background: rgba(255, 255, 255, 0.25);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255, 255, 255, 0.18);
    }
    .status-badge {
        padding: 4px 12px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 500;
    }
    .status-active { background-color: #dcfce7; color: #166534; }
    .status-pending { background-color: #fef3c7; color: #d97706; }
    .status-inactive { background-color: #fee2e2; color: #dc2626; }
    .chart-container {
        min-height: 300px;
        background: white;
        border-radius: 12px;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
    }
    .pagination-container {
        display: flex;
        justify-content: center;
        align-items: center;
        margin-top: 2rem;
        gap: 0.5rem;
    }
    .pagination-info {
        color: #6b7280;
        font-size: 0.875rem;
    }
    .pagination-container {
        display: flex;
        justify-content: center;
        align-items: center;
        margin-top: 2rem;
        gap: 0.5rem;
    }
    .pagination-info {
        color: #6b7280;
        font-size: 0.875rem;
    }
</style>

<!-- Header -->
<header class="gradient-bg text-white">
    <div class="container mx-auto px-6 py-8">
        <div class="flex items-center justify-between">
            <div>
                <h1 class="text-3xl font-bold mb-2">TDS Report - Lease Payable</h1>
                <p class="text-blue-100">Comprehensive Tax Deducted at Source reporting for lease payments</p>
            </div>
            <div class="flex items-center space-x-4">
                <div class="glass-effect rounded-lg px-4 py-2">
                    <span class="text-sm">Last Updated: <span id="lastUpdated">@DateTime.Now.ToString("dd MMM yyyy HH:mm")</span></span>
                </div>
            </div>
        </div>
    </div>
</header>

<div class="container mx-auto px-6 py-8">
    <!-- No Data Alert -->
    @if (Model.TotalRecords == 0 && ViewBag.DiagnosticInfo != null)
    {
        <div class="bg-orange-50 border border-orange-200 rounded-lg p-4 mb-6">
            <div class="flex items-center">
                <i class="ri-information-line text-orange-600 text-xl mr-3"></i>
                <div>
                    <h4 class="text-orange-800 font-medium">No TDS Data Available</h4>
                    <p class="text-orange-700 text-sm mt-1">
                        @if (!ViewBag.DiagnosticInfo.HasData)
                        {
                            <span>No Monthly Rent Payments found in the database. Please create some payments first.</span>
                        }
                        else if (!ViewBag.DiagnosticInfo.HasTDSData)
                        {
                            <span>Monthly Rent Payments exist but none have TDS amounts. Try checking "Include Zero TDS Payments" or configure TDS rates.</span>
                        }
                        else
                        {
                            <span>No data matches your current filter criteria. Try adjusting the filters below.</span>
                        }
                    </p>
                </div>
            </div>
        </div>
    }

    <!-- Quick Stats Dashboard -->
    <div class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-8">
        <div class="bg-white rounded-xl p-6 shadow-sm border border-gray-100">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm font-medium text-gray-600">Total Payments</p>
                    <p class="text-2xl font-bold text-gray-900" id="totalPayments">@Model.Summary.TotalPayments</p>
                </div>
                <div class="w-12 h-12 bg-blue-100 rounded-lg flex items-center justify-center">
                    <i class="ri-calendar-check-line text-blue-600 text-xl"></i>
                </div>
            </div>
        </div>
        <div class="bg-white rounded-xl p-6 shadow-sm border border-gray-100">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm font-medium text-gray-600">Gross Amount</p>
                    <p class="text-2xl font-bold text-gray-900" id="totalGrossAmount">₹@Model.Summary.TotalGrossAmount.ToString("N2")</p>
                </div>
                <div class="w-12 h-12 bg-green-100 rounded-lg flex items-center justify-center">
                    <i class="ri-money-dollar-circle-line text-green-600 text-xl"></i>
                </div>
            </div>
        </div>
        <div class="bg-white rounded-xl p-6 shadow-sm border border-gray-100">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm font-medium text-gray-600">TDS Amount</p>
                    <p class="text-2xl font-bold text-gray-900" id="totalTDSAmount">₹@Model.Summary.TotalTDSAmount.ToString("N2")</p>
                </div>
                <div class="w-12 h-12 bg-purple-100 rounded-lg flex items-center justify-center">
                    <i class="ri-percent-line text-purple-600 text-xl"></i>
                </div>
            </div>
        </div>
        <div class="bg-white rounded-xl p-6 shadow-sm border border-gray-100">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm font-medium text-gray-600">Unique Vendors</p>
                    <p class="text-2xl font-bold text-gray-900" id="uniqueVendors">@Model.Summary.UniqueVendors</p>
                </div>
                <div class="w-12 h-12 bg-orange-100 rounded-lg flex items-center justify-center">
                    <i class="ri-team-line text-orange-600 text-xl"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Report Configuration and Data -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 mb-8">
        <!-- Filter Configuration -->
        <div class="lg:col-span-1">
            <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-6">
                <h3 class="text-lg font-semibold mb-6 flex items-center">
                    <i class="ri-settings-line mr-2 text-primary"></i>
                    Filter Configuration
                </h3>
                
                <form id="tdsReportForm" class="space-y-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-2">Date Range</label>
                        <div class="grid grid-cols-2 gap-2">
                            <input type="date" id="FromDate" name="FromDate" value="@Model.Filter.FromDate?.ToString("yyyy-MM-dd")" class="border border-gray-300 rounded-lg px-3 py-2 focus:ring-2 focus:ring-primary focus:border-primary">
                            <input type="date" id="ToDate" name="ToDate" value="@Model.Filter.ToDate?.ToString("yyyy-MM-dd")" class="border border-gray-300 rounded-lg px-3 py-2 focus:ring-2 focus:ring-primary focus:border-primary">
                        </div>
                    </div>

                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-2">Employee Code</label>
                        <input type="text" id="EmployeeCode" name="EmployeeCode" value="@Model.Filter.EmployeeCode" placeholder="Enter employee code" class="w-full border border-gray-300 rounded-lg px-3 py-2 focus:ring-2 focus:ring-primary focus:border-primary">
                    </div>

                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-2">Employee Name</label>
                        <input type="text" id="EmployeeName" name="EmployeeName" value="@Model.Filter.EmployeeName" placeholder="Enter employee name" class="w-full border border-gray-300 rounded-lg px-3 py-2 focus:ring-2 focus:ring-primary focus:border-primary">
                    </div>

                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-2">Vendor Code</label>
                        <input type="text" id="VendorCode" name="VendorCode" value="@Model.Filter.VendorCode" placeholder="Enter vendor code" class="w-full border border-gray-300 rounded-lg px-3 py-2 focus:ring-2 focus:ring-primary focus:border-primary">
                    </div>

                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-2">Vendor Name</label>
                        <input type="text" id="VendorName" name="VendorName" value="@Model.Filter.VendorName" placeholder="Enter vendor name" class="w-full border border-gray-300 rounded-lg px-3 py-2 focus:ring-2 focus:ring-primary focus:border-primary">
                    </div>

                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-2">PAN Number</label>
                        <input type="text" id="PAN" name="PAN" value="@Model.Filter.PAN" placeholder="Enter PAN number" class="w-full border border-gray-300 rounded-lg px-3 py-2 focus:ring-2 focus:ring-primary focus:border-primary">
                    </div>

                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-2">TDS Applicable</label>
                        <select id="TDSApplicableId" name="TDSApplicableId" class="w-full border border-gray-300 rounded-lg px-3 py-2 focus:ring-2 focus:ring-primary focus:border-primary">
                            <option value="" selected>All TDS Types</option>
                            @if (ViewBag.TDSApplicable != null)
                            {
                                @foreach (var tds in ViewBag.TDSApplicable)
                                {
                                   @*  var isSelected = Model.Filter.TDSApplicableId == tds.Id ? "selected" : ""; *@
                                    @* <option value="@tds.Id" selected="@isSelected">@tds.Name</option> *@
                                    <option value="@tds.Id" >@tds.Name</option>
                                }
                            }
                        </select>
                    </div>

                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-2">Amount Range</label>
                        <div class="grid grid-cols-2 gap-2">
                            <input type="number" id="MinAmount" name="MinAmount" value="@Model.Filter.MinAmount" placeholder="Min" class="border border-gray-300 rounded-lg px-3 py-2 focus:ring-2 focus:ring-primary focus:border-primary">
                            <input type="number" id="MaxAmount" name="MaxAmount" value="@Model.Filter.MaxAmount" placeholder="Max" class="border border-gray-300 rounded-lg px-3 py-2 focus:ring-2 focus:ring-primary focus:border-primary">
                        </div>
                    </div>

                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-2">Payment Status</label>
                        <select id="PaymentStatus" name="PaymentStatus" class="w-full border border-gray-300 rounded-lg px-3 py-2 focus:ring-2 focus:ring-primary focus:border-primary">
                            <option value="" selected>All Status</option>
                            @if (ViewBag.PaymentStatusOptions != null)
                            {
                                @foreach (var status in ViewBag.PaymentStatusOptions)
                                {
                          
                                    <option value="@status.Value">@status.Text</option>

                                }
                            }
                        </select>
                    </div>

                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-2">Financial Year</label>
                        <select id="FinancialYear" name="FinancialYear" class="w-full border border-gray-300 rounded-lg px-3 py-2 focus:ring-2 focus:ring-primary focus:border-primary">
                            @if (ViewBag.FinancialYearOptions != null)
                            {
                                @foreach (var year in ViewBag.FinancialYearOptions)
                                {
                                    var isSelected = Model.Filter.FinancialYear == year.Value ? "selected" : "";
                                    <option value="@year.Value" selected="@isSelected">@year.Text</option>
                                }
                            }
                        </select>
                    </div>

                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-2">Month</label>
                        <select id="Month" name="Month" class="w-full border border-gray-300 rounded-lg px-3 py-2 focus:ring-2 focus:ring-primary focus:border-primary">
                            @if (ViewBag.MonthOptions != null)
                            {
                                @foreach (var month in ViewBag.MonthOptions)
                                {
                                    var isSelected = Model.Filter.Month == month.Value ? "selected" : "";
                                    if (Model.Filter.Month == month.Value)
                                    {
                                        <option value="@month.Value" selected="selected">@month.Text</option>

                                    }
                                    else
                                    {
                                        <option value="@month.Value" >@month.Text</option>

                                    }
                                }
                            }
                        </select>
                    </div>

                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-2">Voucher Number</label>
                        <input type="text" id="VoucherNumber" name="VoucherNumber" value="@Model.Filter.VoucherNumber" placeholder="Enter voucher number" class="w-full border border-gray-300 rounded-lg px-3 py-2 focus:ring-2 focus:ring-primary focus:border-primary">
                    </div>

                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-2">Sort By</label>
                        <select id="SortBy" name="SortBy" class="w-full border border-gray-300 rounded-lg px-3 py-2 focus:ring-2 focus:ring-primary focus:border-primary">
                            @if (ViewBag.SortOptions != null)
                            {
                                @foreach (var sort in ViewBag.SortOptions)
                                {
                                    var isSelected = Model.Filter.SortBy == sort.Value ? "selected" : "";
                                    <option value="@sort.Value" selected="@isSelected">@sort.Text</option>
                                }
                            }
                        </select>
                    </div>

                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-2">Sort Order</label>
                        <select id="SortOrder" name="SortOrder" class="w-full border border-gray-300 rounded-lg px-3 py-2 focus:ring-2 focus:ring-primary focus:border-primary">
                            @{
                                var descSelected = Model.Filter.SortOrder == "DESC" ? "selected" : "";
                                var ascSelected = Model.Filter.SortOrder == "ASC" ? "selected" : "";
                            }
                            <option value="DESC" selected="@descSelected">Descending</option>
                            <option value="ASC" selected="@ascSelected">Ascending</option>
                        </select>
                    </div>

                    <div>
                        <label class="flex items-center">
                            <input type="checkbox" id="IncludeZeroTDS" name="IncludeZeroTDS" @(Model.Filter.IncludeZeroTDS ? "checked" : "") class="rounded border-gray-300 text-primary focus:ring-primary">
                            <span class="ml-2 text-sm text-gray-600">Include Zero TDS Payments</span>
                        </label>
                    </div>

                    <div class="flex space-x-2">
                        <button type="button" onclick="applyFilter()" class="flex-1 bg-primary text-white py-3 px-4 rounded-lg hover:bg-primary/90 flex items-center justify-center transition-colors">
                            <i class="ri-search-line mr-2"></i>
                            Apply Filter
                        </button>
                        <button type="button" onclick="clearFilter()" class="px-4 py-3 bg-gray-500 text-white rounded-lg hover:bg-gray-600 flex items-center transition-colors">
                            <i class="ri-refresh-line"></i>
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <!-- Data Table -->
        <div class="lg:col-span-2">
            <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-6">
                <div class="flex items-center justify-between mb-6">
                    <h3 class="text-lg font-semibold flex items-center">
                        <i class="ri-table-line mr-2 text-primary"></i>
                        TDS Report Data
                    </h3>
                    <div class="flex items-center space-x-2">
                        <span class="text-sm text-gray-600">Total Records: <span id="recordCount" class="font-semibold">@Model.TotalRecords</span></span>
                        <div class="flex space-x-2">
                            <button onclick="exportReport('PDF')" class="px-3 py-2 bg-red-600 text-white rounded-lg hover:bg-red-700 flex items-center text-sm">
                                <i class="ri-file-pdf-line mr-1"></i>
                                PDF
                            </button>
                            <button onclick="exportReport('Excel')" class="px-3 py-2 bg-green-600 text-white rounded-lg hover:bg-green-700 flex items-center text-sm">
                                <i class="ri-file-excel-line mr-1"></i>
                                Excel
                            </button>
                            <button onclick="exportReport('CSV')" class="px-3 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 flex items-center text-sm">
                                <i class="ri-file-text-line mr-1"></i>
                                CSV
                            </button>
                        </div>
                    </div>
                </div>

                <div class="loading-spinner" id="loadingSpinner" style="display: none;">
                    <div class="flex items-center justify-center py-8">
                        <div class="animate-spin rounded-full h-8 w-8 border-b-2 border-primary"></div>
                        <span class="ml-2 text-gray-600">Loading report data...</span>
                    </div>
                </div>

                <div class="overflow-x-auto">
                    <table class="min-w-full divide-y divide-gray-200">
                        <thead class="bg-gray-50">
                            <tr>
                                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Sl No</th>
                                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Voucher No.</th>
                                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Code</th>
                                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Name</th>
                                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">PAN</th>
                                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Date</th>
                                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">TDS Deducted on</th>
                                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">TDS %</th>
                                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">TDS Amount</th>
                                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Gross CN Value</th>
                                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Project Name</th>
                                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">CoA Name</th>
                                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Narration</th>
                                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Exemption Certificate No.</th>
                                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Exemption From Dt.</th>
                                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Exemption To Dt.</th>

                            </tr>
                        </thead>
                        <tbody id="tdsReportTable" class="bg-white divide-y divide-gray-200">
                            @if (Model.TDSItems != null && Model.TDSItems.Any())
                            {
                                foreach (var item in Model.TDSItems)
                                {
                                    <tr class="hover:bg-gray-50">
                                        <td class="px-6 py-4 whitespace-nowrap">
                                            <span class="status-badge status-active">@item.SlNo</span>
                                        </td>
                                        <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">@item.VoucherNumber</td>
                                        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">@item.EmployeeCode</td>
                                        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">@item.EmployeeName</td>
                                        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">@item.PAN</td>
                                        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">@item.PaymentDate.ToString("dd/MM/yyyy")</td>
                                        <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">₹@item.TDSDeductedOn.ToString("N2")</td>
                                        <td class="px-6 py-4 whitespace-nowrap">
                                            <span class="status-badge status-pending">@item.TDSRate.ToString("N2")%</span>
                                        </td>
                                        <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-green-600">₹@item.TDSAmount.ToString("N2")</td>
                                        <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">₹@item.GrossValue.ToString("N2")</td>
                                        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">@item.ProjectName</td>
                                        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">@item.CoAName</td>
                                        <td class="px-6 py-4 text-sm text-gray-500" title="@item.Narration">@(item.Narration.Length > 30 ? item.Narration.Substring(0, 30) + "..." : item.Narration)</td>
                                        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">@item.ExemptionCertificateNo</td>
                                        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">@(item.ExemptionFromDate?.ToString("dd/MM/yyyy") ?? "-")</td>
                                        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">@(item.ExemptionToDate?.ToString("dd/MM/yyyy") ?? "-")</td>

                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="16" class="px-6 py-12 text-center">
                                        <div class="text-gray-500">
                                            <i class="ri-inbox-line text-4xl mb-4"></i>
                                            <h5 class="text-lg font-medium">No TDS data found</h5>
                                            <p class="text-sm">Try adjusting your filter options to see more results.</p>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Pagination -->
                <div class="pagination-container" id="paginationContainer" style="display: none;">
                    <div class="flex items-center space-x-2">
                        <button onclick="changePage(1)" class="px-3 py-2 bg-gray-200 text-gray-700 rounded-lg hover:bg-gray-300">
                            <i class="ri-arrow-left-s-line"></i>
                        </button>
                        <button onclick="changePage(currentPage - 1)" id="prevPage" class="px-3 py-2 bg-gray-200 text-gray-700 rounded-lg hover:bg-gray-300">
                            Previous
                        </button>
                        <span class="pagination-info">
                            Page <span id="currentPageDisplay">1</span> of <span id="totalPagesDisplay">1</span>
                        </span>
                        <button onclick="changePage(currentPage + 1)" id="nextPage" class="px-3 py-2 bg-gray-200 text-gray-700 rounded-lg hover:bg-gray-300">
                            Next
                        </button>
                        <button onclick="changePage(totalPages)" class="px-3 py-2 bg-gray-200 text-gray-700 rounded-lg hover:bg-gray-300">
                            <i class="ri-arrow-right-s-line"></i>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>



<!-- Toast Notification -->
<div id="toast" class="fixed bottom-6 right-6 bg-primary text-white px-6 py-3 rounded-lg shadow-lg z-50 hidden transform transition-transform">
    <div class="flex items-center">
        <i class="ri-check-line mr-2"></i>
        <span id="toastMessage">Report updated successfully!</span>
    </div>
</div>

@section Scripts {
    <script>
        let currentPage = 1;
        let totalPages = 1;
        let pageSize = 20;

        function applyFilter() {
            showLoading();
            const formData = new FormData(document.getElementById('tdsReportForm'));
            const filterData = Object.fromEntries(formData.entries());
            
            filterData.IncludeZeroTDS = document.getElementById('IncludeZeroTDS').checked;
            filterData.Page = currentPage;
            filterData.PageSize = pageSize;
            
            $.ajax({
                url: '@Url.Action("Details", "TDSReport")',
                type: 'GET',
                data: filterData,
                headers: { 'X-Requested-With': 'XMLHttpRequest' },
                success: function(response) {
                    hideLoading();
                    if (response.success) {
                        updateReportTable(response.data);
                        updateSummary(response.data.summary);
                        updatePagination(response.data.totalRecords);
                        showToast('Report data updated successfully!');
                    } else {
                        showToast('Error loading report data', 'error');
                    }
                },
                error: function() {
                    hideLoading();
                    showToast('Error loading report data', 'error');
                }
            });
        }

        function clearFilter() {
            document.getElementById('tdsReportForm').reset();
            currentPage = 1;
            applyFilter();
        }

        function expandDateRange() {
            // Set date range to last 12 months
            const toDate = new Date();
            const fromDate = new Date();
            fromDate.setMonth(fromDate.getMonth() - 12);
            
            document.getElementById('FromDate').value = fromDate.toISOString().split('T')[0];
            document.getElementById('ToDate').value = toDate.toISOString().split('T')[0];
            
            // Clear other restrictive filters but keep defaults
            document.getElementById('EmployeeCode').value = '';
            document.getElementById('EmployeeName').value = '';
            document.getElementById('VendorCode').value = '';
            document.getElementById('VendorName').value = '';
            document.getElementById('PAN').value = '';
            document.getElementById('PaymentStatus').value = ''; // Default to "All Status"
            document.getElementById('TDSApplicableId').value = ''; // Default to "All TDS Types"
            
            // Set current financial year and month
            var currentYear = new Date().getFullYear();
            var currentFinancialYear = currentYear + '-' + (currentYear + 1).toString().substring(2);
            document.getElementById('FinancialYear').value = currentFinancialYear;
            
            var currentMonth = new Date().toLocaleString('en-US', { month: 'long' });
            document.getElementById('Month').value = currentMonth;
            
            currentPage = 1;
            applyFilter();
        }

        function includeZeroTDS() {
            document.getElementById('IncludeZeroTDS').checked = true;
            currentPage = 1;
            applyFilter();
        }

        function changePage(page) {
            if (page < 1 || page > totalPages) return;
            currentPage = page;
            applyFilter();
        }

        function updatePagination(totalRecords) {
            totalPages = Math.ceil(totalRecords / pageSize);
            
            if (totalPages > 1) {
                $('#paginationContainer').show();
                $('#currentPageDisplay').text(currentPage);
                $('#totalPagesDisplay').text(totalPages);
                
                $('#prevPage').prop('disabled', currentPage <= 1);
                $('#nextPage').prop('disabled', currentPage >= totalPages);
            } else {
                $('#paginationContainer').hide();
            }
        }

        function showLoading() {
            $('#loadingSpinner').show();
            $('#tdsReportTable').hide();
            $('#paginationContainer').hide();
        }

        function hideLoading() {
            $('#loadingSpinner').hide();
            $('#tdsReportTable').show();
        }

        function updateReportTable(data) {
            const tbody = $('#tdsReportTable');
            tbody.empty();
            
            if (data.tdsItems && data.tdsItems.length > 0) {
                data.tdsItems.forEach(function(item, index) {
                    const row = `
                        <tr class="hover:bg-gray-50">
                            <td class="px-6 py-4 whitespace-nowrap">
                                <span class="status-badge status-active">${item.slNo}</span>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">${item.voucherNumber}</td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">${item.employeeCode}</td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">${item.employeeName}</td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">${item.pan}</td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">${new Date(item.paymentDate).toLocaleDateString('en-GB')}</td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">₹${parseFloat(item.tdsDeductedOn).toLocaleString('en-IN', {minimumFractionDigits: 2})}</td>
                            <td class="px-6 py-4 whitespace-nowrap">
                                <span class="status-badge status-pending">${parseFloat(item.tdsRate).toFixed(2)}%</span>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-green-600">₹${parseFloat(item.tdsAmount).toLocaleString('en-IN', {minimumFractionDigits: 2})}</td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">₹${parseFloat(item.grossValue).toLocaleString('en-IN', {minimumFractionDigits: 2})}</td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">${item.projectName}</td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">${item.coAName}</td>
                            <td class="px-6 py-4 text-sm text-gray-500" title="${item.narration}">${item.narration.length > 30 ? item.narration.substring(0, 30) + '...' : item.narration}</td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">${item.exemptionCertificateNo}</td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">${item.exemptionFromDate ? new Date(item.exemptionFromDate).toLocaleDateString('en-GB') : '-'}</td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">${item.exemptionToDate ? new Date(item.exemptionToDate).toLocaleDateString('en-GB') : '-'}</td>
                        </tr>
                    `;
                    tbody.append(row);
                });
            } else {
                tbody.append(`
                    <tr>
                        <td colspan="17" class="px-6 py-12 text-center">
                            <div class="text-gray-500">
                                <i class="ri-inbox-line text-4xl mb-4"></i>
                                <h5 class="text-lg font-medium">No TDS data found</h5>
                                <p class="text-sm">Try adjusting your filter options to see more results.</p>
                            </div>
                        </td>
                    </tr>
                `);
            }
            
            $('#recordCount').text(data.totalRecords || 0);
        }

        function updateSummary(summary) {
            $('#totalPayments').text(summary.totalPayments || 0);
            $('#totalGrossAmount').text('₹' + (parseFloat(summary.totalGrossAmount || 0).toLocaleString('en-IN', {minimumFractionDigits: 2})));
            $('#totalTDSAmount').text('₹' + (parseFloat(summary.totalTDSAmount || 0).toLocaleString('en-IN', {minimumFractionDigits: 2})));
            $('#uniqueVendors').text(summary.uniqueVendors || 0);
        }



        function exportReport(format) {
            showLoading();
            const formData = new FormData(document.getElementById('tdsReportForm'));
            formData.append('format', format);
            
            const form = document.createElement('form');
            form.method = 'POST';
            form.action = '@Url.Action("Export", "TDSReport")';
            
            for (let [key, value] of formData.entries()) {
                const input = document.createElement('input');
                input.type = 'hidden';
                input.name = key;
                input.value = value;
                form.appendChild(input);
            }
            
            const checkboxInput = document.createElement('input');
            checkboxInput.type = 'hidden';
            checkboxInput.name = 'IncludeZeroTDS';
            checkboxInput.value = document.getElementById('IncludeZeroTDS').checked;
            form.appendChild(checkboxInput);
            
            document.body.appendChild(form);
            form.submit();
            document.body.removeChild(form);
            
            setTimeout(() => {
                hideLoading();
                showToast('Export completed successfully!');
            }, 2000);
        }

        function showToast(message, type = 'success') {
            const toast = document.getElementById('toast');
            const toastMessage = document.getElementById('toastMessage');
            
            toast.className = `fixed bottom-6 right-6 px-6 py-3 rounded-lg shadow-lg z-50 transform transition-transform ${type === 'error' ? 'bg-red-600' : 'bg-primary'} text-white`;
            toastMessage.textContent = message;
            
            toast.classList.remove('hidden');
            toast.classList.add('translate-y-0');
            
            setTimeout(() => {
                toast.classList.add('hidden');
            }, 3000);
        }

        $(document).ready(function() {
            // Initialize pagination
            updatePagination(@Model.TotalRecords);
            
            // Set default date range if not set
            if (!$('#FromDate').val()) {
                $('#FromDate').val(new Date(Date.now() - 30 * 24 * 60 * 60 * 1000).toISOString().split('T')[0]);
            }
            if (!$('#ToDate').val()) {
                $('#ToDate').val(new Date().toISOString().split('T')[0]);
            }
            
            // Set default Financial Year to current year if not set
            if (!$('#FinancialYear').val()) {
                var currentYear = new Date().getFullYear();
                var currentFinancialYear = currentYear + '-' + (currentYear + 1).toString().substring(2);
                $('#FinancialYear').val(currentFinancialYear);
            }
            
            // Set default Month to current month if not set
            if (!$('#Month').val()) {
                var currentMonth = new Date().toLocaleString('en-US', { month: 'long' });
                $('#Month').val(currentMonth);
            }
            
            // Set default TDS Applicable to "All TDS Types" if not set
            if (!$('#TDSApplicableId').val()) {
                $('#TDSApplicableId').val('');
            }
            
            // Set default Payment Status to "All Status" if not set
            if (!$('#PaymentStatus').val()) {
                $('#PaymentStatus').val('');
            }
            
            // Show pagination if there are multiple pages
            if (@Model.TotalRecords > 20) {
                $('#paginationContainer').show();
            }
        });
    </script>
}
