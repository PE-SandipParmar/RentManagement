        // Get today's date in YYYY-MM-DD format for date input max attribute
        function getTodayDate() {
            const today = new Date();
            const year = today.getFullYear();
            const month = String(today.getMonth() + 1).padStart(2, '0');
            const day = String(today.getDate()).padStart(2, '0');
            return `${year}-${month}-${day}`;
        }

        // Set max date attributes when drawer opens
        function setDateLimitations() {
            const todayDate = getTodayDate();

            // Set max attribute for date inputs to prevent future date selection
            const refDateInput = document.querySelector('[name="RefDate"]');
            const fromDateInput = document.querySelector('[name="FromDate"]');

            if (refDateInput) {
                refDateInput.setAttribute('max', todayDate);
            }

            if (fromDateInput) {
                fromDateInput.setAttribute('max', todayDate);
            }
        }

        // Validate individual date field
        function validateDateField(input, fieldName, displayName) {
            const selectedDate = new Date(input.value);
            const today = new Date();

            // Reset time part for accurate comparison
            today.setHours(0, 0, 0, 0);
            selectedDate.setHours(0, 0, 0, 0);

            const errorSpan = document.querySelector(`[data-validation="${fieldName}"]`);

            // Clear previous error
            if (errorSpan) {
                errorSpan.textContent = '';
            }
            input.classList.remove('border-red-500');

            // Check if date is in the future
            if (selectedDate > today) {
                const errorMessage = `${displayName} cannot be a future date`;
                if (errorSpan) {
                    errorSpan.textContent = errorMessage;
                }
                input.classList.add('border-red-500');
                return false;
            }

            return true;
        }

