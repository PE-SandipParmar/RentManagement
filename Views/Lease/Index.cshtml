        //     // Prevent default drag behaviors
        //     ['dragenter', 'dragover', 'dragleave', 'drop'].forEach(eventName => {
        //         dropZone.addEventListener(eventName, preventDefaults, false);
        //         document.body.addEventListener(eventName, preventDefaults, false);
        //     });
        // }
        function initializeDocumentUploadListeners() {
            const fileInput = document.getElementById('leaseDocumentUpload');
            const dropZone = document.getElementById('documentDropZone');

            // File input change event
            fileInput.addEventListener('change', handleFileSelect);

            // Drag and drop events
            dropZone.addEventListener('dragover', handleDragOver);
            dropZone.addEventListener('dragleave', handleDragLeave);
            dropZone.addEventListener('drop', handleFileDrop);

            // Prevent default drag behaviors
            ['dragenter', 'dragover', 'dragleave', 'drop'].forEach(eventName => {
                dropZone.addEventListener(eventName, preventDefaults, false);
                document.body.addEventListener(eventName, preventDefaults, false);
            });
        }

        function preventDefaults(e) {
            e.preventDefault();
            e.stopPropagation();
        }

        function handleDragOver(e) {
            e.dataTransfer.dropEffect = 'copy';
            document.getElementById('documentDropZone').classList.add('border-blue-400', 'bg-blue-50');
        }

        function handleDragLeave(e) {
            document.getElementById('documentDropZone').classList.remove('border-blue-400', 'bg-blue-50');
        }

        function handleFileDrop(e) {
            const files = e.dataTransfer.files;
            document.getElementById('documentDropZone').classList.remove('border-blue-400', 'bg-blue-50');
            processFiles(files);
        }

        function handleFileSelect(e) {
            const files = e.target.files;
            processFiles(files);
        }

        function processFiles(files) {
            for (let i = 0; i < files.length; i++) {
                const file = files[i];
                if (validateFile(file)) {
                    addFileToUploadList(file);
                }
            }

            // Clear the file input
            document.getElementById('leaseDocumentUpload').value = '';
        }

        function validateFile(file) {
            // Check file size
            if (file.size > maxFileSize) {
                showAlert('error', `File "${file.name}" is too large. Maximum size is 10MB.`);
                return false;
            }

            // Check file type
            if (!allowedFileTypes.includes(file.type)) {
                showAlert('error', `File "${file.name}" has an invalid file type. Only PDF, DOC, DOCX, JPG, and PNG files are allowed.`);
                return false;
            }

            // Check if file already exists in upload list
            if (uploadedFiles.some(f => f.name === file.name && f.size === file.size)) {
                showAlert('error', `File "${file.name}" is already selected for upload.`);
                return false;
            }

            return true;
        }

        function addFileToUploadList(file) {
            const fileId = Date.now() + Math.random();
            const fileObj = {
                id: fileId,
                file: file,
                name: file.name,
                size: file.size,
                type: file.type
            };

            uploadedFiles.push(fileObj);
            displayUploadedFile(fileObj);
        }

        function displayUploadedFile(fileObj) {
            const filesList = document.getElementById('uploadedFilesList');
            const fileIcon = getFileIcon(fileObj.type);
            const fileSize = formatFileSize(fileObj.size);

            const fileElement = document.createElement('div');
            fileElement.className = 'flex items-center justify-between p-3 bg-gray-50 rounded-lg border border-gray-200';
            fileElement.id = `file-${fileObj.id}`;

