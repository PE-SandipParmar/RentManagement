        function populateForm(data) {
            console.log('=== POPULATE FORM START ===');
            console.log('Populating form with data:', data);
            console.log('MaintenancePayment value:', data.maintenancePayment || data.MaintenancePayment);
            console.log('VendorId from data:', data.vendorId || data.VendorId);
            console.log('EmployeeId from data:', data.employeeId || data.EmployeeId);
            console.log('=== POPULATE FORM DATA END ===');
            glbVendorId = data.vendorId;
            document.getElementById('leaseId').value = data.id || data.Id || 0;

            const perquisiteType = data.perquisiteType || data.PerquisiteType || 'Non-Government';
            const perquisiteRadio = document.querySelector(`input[name="PerquisiteType"][value="${perquisiteType}"]`);
            if (perquisiteRadio) perquisiteRadio.checked = true;

            const fieldMappings = {
                'RefNo': ['refNo', 'RefNo'],
                'MonthlyRentPayable': ['monthlyRentPayable', 'MonthlyRentPayable'],
                'RentAmount': ['rentAmount', 'RentAmount'],
                'AdditionalRentRecovery': ['additionalRentRecovery', 'AdditionalRentRecovery'],
                'RentDeposit': ['rentDeposit', 'RentDeposit'],
                'BrokerageAmount': ['brokerageAmount', 'BrokerageAmount'],
                'StampDuty': ['stampDuty', 'StampDuty'],
                'LicenseFeeAmount': ['licenseFeeAmount', 'LicenseFeeAmount'],
                'MaintenancePayment': ['maintenancePayment', 'MaintenancePayment'],
                'Narration': ['narration', 'Narration']
            };

            Object.keys(fieldMappings).forEach(fieldName => {
                const element = document.querySelector(`[name="${fieldName}"]`);
                if (element) {
                    let value = null;
                    for (const prop of fieldMappings[fieldName]) {
                        if (data[prop] !== undefined) {
                            value = data[prop];
                            break;
                        }
                    }
                    element.value = value || '';
                    
                    // Update character counter for Narration
                    if (fieldName === 'Narration' && element.id === 'createNarration') {
                        const counter = document.getElementById('createNarrationCount');
                        if (counter) {
                            counter.textContent = (value || '').length;
                        }
                    }
                }
            });

            // For editing, populate RentAmount and AdditionalRentRecovery directly from data first
            // Only recalculate if MonthlyRentPayable is changed by user
            const rentAmountElement = document.querySelector('input[name="RentAmount"]');
            const additionalRentRecoveryElement = document.querySelector('input[name="AdditionalRentRecovery"]');
            
            if (rentAmountElement && additionalRentRecoveryElement) {
                // Set the actual values from database
                const rentAmount = data.rentAmount || data.RentAmount;
                const additionalRentRecovery = data.additionalRentRecovery || data.AdditionalRentRecovery;
                
                if (rentAmount !== undefined) {
                    rentAmountElement.value = rentAmount;
                }
                if (additionalRentRecovery !== undefined) {
                    additionalRentRecoveryElement.value = additionalRentRecovery;
                }
            }

            const dateFieldMappings = {
                'RefDate': ['refDate', 'RefDate'],
                'FromDate': ['fromDate', 'FromDate'],
                'EndDate': ['endDate', 'EndDate']
            };

            Object.keys(dateFieldMappings).forEach(fieldName => {
                const element = document.querySelector(`[name="${fieldName}"]`);
                if (element) {
                    let value = null;
                    for (const prop of dateFieldMappings[fieldName]) {
                        if (data[prop]) {
                            value = data[prop];
                            break;
                        }
                    }
                    if (value) {
                        element.value = value.split('T')[0];
                    }
                }
