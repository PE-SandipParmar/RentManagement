        // Function to calculate Rent Amount and Additional Rent Recovery based on Monthly Rent Payable
        function calculateRentAmounts() {
            const monthlyRentPayableInput = document.querySelector('input[name="MonthlyRentPayable"]');
            const rentAmountInput = document.querySelector('input[name="RentAmount"]');
            const additionalRentRecoveryInput = document.querySelector('input[name="AdditionalRentRecovery"]');
            
            if (!monthlyRentPayableInput || !rentAmountInput || !additionalRentRecoveryInput) {
                return;
            }

            const monthlyRentPayable = parseFloat(monthlyRentPayableInput.value) || 0;
            
            if (monthlyRentPayable <= 0) {
                rentAmountInput.value = '';
                additionalRentRecoveryInput.value = '';
                return;
            }

            // If we have HRA limit, use it; otherwise, set Rent Amount equal to Monthly Rent Payable
            if (maxAllowedRent && monthlyRentPayable > maxAllowedRent) {
                // If Monthly Rent Payable exceeds HRA limit, split it
                rentAmountInput.value = maxAllowedRent.toFixed(2);
                additionalRentRecoveryInput.value = (monthlyRentPayable - maxAllowedRent).toFixed(2);
            } else {
                // If Monthly Rent Payable is within HRA limit or no HRA limit, set Rent Amount to Monthly Rent Payable
                rentAmountInput.value = monthlyRentPayable.toFixed(2);
                additionalRentRecoveryInput.value = '0.00';
            }
        }
