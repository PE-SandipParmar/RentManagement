        // Function to fetch vendors by employee
        async function fetchVendorsByEmployee(employeeId) {
            console.log('fetchVendorsByEmployee called with employeeId:', employeeId);
            
            const vendorSelect = document.querySelector('select[name="VendorId"]');
            if (!vendorSelect) {
                console.error('Vendor select not found');
                return;
            }

            // Show loading state
            vendorSelect.innerHTML = '<option value="0">Loading vendors...</option>';
            vendorSelect.disabled = true;

            const url = `@Url.Action("GetVendorsByEmployee")?employeeId=${employeeId}`;
            console.log('Fetching from URL:', url);

            fetch(url)
                .then(response => {
                    console.log('Response status:', response.status);
                    if (!response.ok) {
                        throw new Error(`HTTP error! status: ${response.status}`);
                    }
                    return response.json();
                })
                .then(result => {
                    console.log('API response:', result);
                    if (result.success) {
                        if (result.data && result.data.length > 0) {
                            console.log('Vendors found:', result.data.length);
                            
                            // Filter out any undefined or invalid vendors from API response
                            const validVendors = result.data.filter(v => v && v.id && v.vendorName);
                            console.log('Valid vendors after filtering:', validVendors);
                            
                            if (validVendors.length > 0) {
                                // Populate vendor dropdown with filtered vendors
                                vendorSelect.innerHTML = '' +
                                    validVendors.map(v => `<option value="${v.id}">${v.vendorName} (${v.vendorCode || 'N/A'})</option>`).join('');
                                
                                // Refresh Select2 if it's initialized
                                if ($(vendorSelect).hasClass('select2-hidden-accessible')) {
                                    $(vendorSelect).trigger('change.select2');
                                }
                            } else {
                                console.error('No valid vendors found after filtering API response');
                                vendorSelect.innerHTML = '<option value="0">No valid owners found for this employee</option>';
                            }
                        } else {
                            console.log('No vendors found for employee');
                            vendorSelect.innerHTML = '<option value="0">No owners found for this employee</option>';
                        }
                    } else {
                        console.error('API returned error:', result.message);
                        vendorSelect.innerHTML = '<option value="0">Error loading owners</option>';
                    }
                    vendorSelect.disabled = false;
                    
                    // Set the vendor if we have a global vendor ID (for editing mode)
                    if (glbVendorId > 0) {
                        vendorSelect.value = glbVendorId;
                        // Trigger Select2 change event if initialized
                        if ($(vendorSelect).hasClass('select2-hidden-accessible')) {
                            $(vendorSelect).trigger('change.select2');
                        }
                    }
                })
                .catch(error => {
                    console.error('Error fetching vendors by employee:', error);
                    vendorSelect.innerHTML = '<option value="0">Error loading owners</option>';
                    vendorSelect.disabled = false;
                });
        }

