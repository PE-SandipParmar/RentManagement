@model TDSBrokeragePeggingModel

<div class="row">
    <div class="col-md-12">
        <div class="card">
            <div class="card-header">
                <h6 class="mb-0">Brokerage Payment Details</h6>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6">
                        <table class="table table-borderless">
                            <tr>
                                <td><strong>Payment ID:</strong></td>
                                <td>@Model.PaymentId</td>
                            </tr>
                            <tr>
                                <td><strong>Payment Type:</strong></td>
                                <td>@Model.PaymentType</td>
                            </tr>
                            <tr>
                                <td><strong>Voucher Number:</strong></td>
                                <td>@Model.VoucherNumber</td>
                            </tr>
                            <tr>
                                <td><strong>Payment Date:</strong></td>
                                <td>@Model.PaymentDate.ToString("dd/MM/yyyy")</td>
                            </tr>
                        </table>
                    </div>
                    <div class="col-md-6">
                        <table class="table table-borderless">
                            <tr>
                                <td><strong>Amount:</strong></td>
                                <td>₹@Model.Amount.ToString("N2")</td>
                            </tr>
                            <tr>
                                <td><strong>Status:</strong></td>
                                <td>
                                    <span class="badge @(Model.Status == "Paid" ? "bg-success" : Model.Status == "Pending" ? "bg-warning" : "bg-danger")">
                                        @Model.Status
                                    </span>
                                </td>
                            </tr>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@if (Model.PeggingDetails != null && Model.PeggingDetails.Any())
{
    <div class="row mt-3">
        <div class="col-md-12">
            <div class="card">
                <div class="card-header">
                    <h6 class="mb-0">Brokerage Pegging Details</h6>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-bordered table-striped">
                            <thead class="table-dark">
                                <tr>
                                    <th>Lease Ref No.</th>
                                    <th>Employee Name</th>
                                    <th>Vendor Name</th>
                                    <th>Allocated Amount</th>
                                    <th>TDS Amount</th>
                                    <th>Net Payable Amount</th>
                                    <th>Month</th>
                                    <th>Year</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var detail in Model.PeggingDetails)
                                {
                                    <tr>
                                        <td>@detail.LeaseRefNo</td>
                                        <td>@detail.EmployeeName</td>
                                        <td>@detail.VendorName</td>
                                        <td>₹@detail.AllocatedAmount.ToString("N2")</td>
                                        <td>₹@detail.TDSAmount.ToString("N2")</td>
                                        <td>₹@detail.NetPayableAmount.ToString("N2")</td>
                                        <td>@detail.Month</td>
                                        <td>@detail.Year</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <div class="row mt-3">
        <div class="col-md-12">
            <div class="alert alert-info">
                <i class="fas fa-info-circle me-2"></i>
                No pegging details available for this brokerage payment.
            </div>
        </div>
    </div>
}

<div class="row mt-3">
    <div class="col-md-12 text-end">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
    </div>
</div>
